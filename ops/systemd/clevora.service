[Unit]
Description=Clevora Web & Minimal API Service (.NET 10)
After=network.target

[Service]
WorkingDirectory=/var/www/clevora
ExecStart=/usr/bin/dotnet /var/www/clevora/Clevora.Web.dll
Restart=always
# Restart service after 10 seconds if dotnet crashes
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=clevora-web
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
Environment=Database__Path=/home/data/app.db

[Install]
WantedBy=multi-user.target
