@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <header class="top-row px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">.NET 10 LTS</span>
                <span class="text-muted small">Clevora Workspace v1.0</span>
            </div>
            <div class="text-end text-muted small">
                <span>Dibuat oleh <strong>Gravicode Studios</strong> dipimpin oleh <strong>Kang Fadhil</strong></span>
            </div>
        </header>

        <article class="content px-4 py-3">
            @Body
        </article>

        <footer class="mt-5 py-3 border-top text-center text-muted small">
            <p class="mb-1">© 2026 Clevora — Platform Penyiapan Pesan WhatsApp Cerdas &amp; Produktif.</p>
            <p class="mb-0 text-secondary" style="font-size: 0.8rem;">
                Prinsip Human-in-the-Loop: Semua pesan ditinjau mandiri sebelum dikirim manual melalui aplikasi WhatsApp resmi.
            </p>
        </footer>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
