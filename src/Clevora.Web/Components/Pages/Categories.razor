@page "/categories"
@using Clevora.Application.Interfaces
@using Clevora.Domain.Entities
@using Microsoft.AspNetCore.Authorization
@inject ICategoryService CategoryService

<PageTitle>Kategori — Clevora</PageTitle>

<div class="page-header">
    <h2>🗂️ Kategori</h2>
    <button class="btn-primary" @onclick="() => ShowForm(null)">+ Buat Kategori</button>
</div>

@if (categories is null)
{
    <p>Memuat…</p>
}
else if (!categories.Any())
{
    <div class="empty-state">Belum ada kategori.</div>
}
else
{
    <div class="category-list">
        @foreach (var c in categories)
        {
            <div class="category-item">
                <span class="cat-icon">@(c.Icon ?? "📁")</span>
                <span class="cat-name">@c.Name</span>
                <span class="cat-desc">@c.Description</span>
                <div class="cat-actions">
                    <button class="btn-icon" @onclick="() => ShowForm(c)">🖊️</button>
                    <button class="btn-icon" @onclick="() => Archive(c)">🗄️</button>
                </div>
            </div>
        }
    </div>
}

@if (formVisible)
{
    <div class="modal-backdrop" @onclick="HideForm">
        <div class="modal" @onclick:stopPropagation>
            <h3>@(editCategory?.Id > 0 ? "Edit" : "Buat") Kategori</h3>
            <label>Nama</label>
            <input @bind="formName" placeholder="Nama kategori" />
            <label>Deskripsi (opsional)</label>
            <input @bind="formDesc" placeholder="Deskripsi singkat" />
            <label>Ikon (emoji, opsional)</label>
            <input @bind="formIcon" placeholder="📁" />
            <div class="modal-actions">
                <button class="btn-secondary" @onclick="HideForm">Batal</button>
                <button class="btn-primary" @onclick="Save">Simpan</button>
            </div>
            @if (!string.IsNullOrEmpty(formError)) { <p class="form-error">@formError</p> }
        </div>
    </div>
}

<style>
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .category-list { display: flex; flex-direction: column; gap: 0.75rem; }
    .category-item { background: white; border: 1px solid #e5e7eb; border-radius: 10px; padding: 0.9rem 1.2rem; display: flex; align-items: center; gap: 1rem; }
    .cat-icon { font-size: 1.5rem; }
    .cat-name { font-weight: 700; min-width: 140px; }
    .cat-desc { color: #6b7280; font-size: 0.9rem; flex: 1; }
    .cat-actions { display: flex; gap: 0.5rem; }
    .btn-icon { background: none; border: none; cursor: pointer; font-size: 1.1rem; }
    .btn-primary { background: #25D366; color: white; border: none; padding: 0.5rem 1.25rem; border-radius: 8px; cursor: pointer; font-weight: 600; }
    .btn-secondary { background: #f3f4f6; border: none; padding: 0.5rem 1.25rem; border-radius: 8px; cursor: pointer; }
    .empty-state { text-align: center; color: #9ca3af; padding: 3rem; }
    .modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 999; }
    .modal { background: white; border-radius: 16px; padding: 2rem; min-width: 380px; }
    .modal label { display: block; font-weight: 600; margin: 0.75rem 0 0.25rem; }
    .modal input { width: 100%; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 8px; }
    .modal-actions { display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.25rem; }
    .form-error { color: #ef4444; margin-top: 0.5rem; }
</style>

@code {
    private IReadOnlyList<TemplateCategory>? categories;
    private bool formVisible;
    private TemplateCategory? editCategory;
    private string formName = string.Empty, formDesc = string.Empty, formIcon = string.Empty, formError = string.Empty;

    protected override async Task OnInitializedAsync() => categories = await CategoryService.GetAllAsync();

    private void ShowForm(TemplateCategory? c)
    {
        editCategory = c;
        formName = c?.Name ?? string.Empty;
        formDesc = c?.Description ?? string.Empty;
        formIcon = c?.Icon ?? string.Empty;
        formError = string.Empty;
        formVisible = true;
    }

    private void HideForm() => formVisible = false;

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(formName)) { formError = "Nama wajib diisi."; return; }
        if (editCategory?.Id > 0)
            await CategoryService.UpdateAsync(editCategory.Id, formName, formDesc, formIcon);
        else
            await CategoryService.CreateAsync(formName, formDesc, formIcon);
        HideForm();
        categories = await CategoryService.GetAllAsync();
    }

    private async Task Archive(TemplateCategory c)
    {
        await CategoryService.ArchiveAsync(c.Id);
        categories = await CategoryService.GetAllAsync();
    }
}
