@code {
    [SupplyParameterFromQuery(Name = "tid")]
    public int? TemplateId { get; set; }

    private List<Clevora.Domain.Entities.MessageTemplate> templates = [];
    private List<AttachmentDto> attachments = [];
    private string templateBody = string.Empty;
    private string recipientPhone = string.Empty;
    private IReadOnlyList<string> placeholders = [];
    private Dictionary<string, string> placeholderValues = new();
    private ComposerPreviewResult? preview;
    private bool aiLoading;
    private string aiError = string.Empty;
    private string copyStatus = "Salin";

    protected override async Task OnInitializedAsync()
    {
        templates = (await TemplateService.GetAllAsync()).ToList();
        if (TemplateId.HasValue && TemplateId > 0)
        {
            var t = await TemplateService.GetByIdAsync(TemplateId.Value);
            if (t is not null) await LoadTemplate(t);
        }
        else
        {
            templateBody = "Halo *{{nama}}*, pesanan *{{produk}}* Anda sebesar ~Rp {{nominal}}~ siap dikirim! Nomor resi: `{{resi}}`";
            recipientPhone = "08123456789";
            placeholderValues["nama"] = "Budi Santoso";
            placeholderValues["produk"] = "Sepatu Kulit";
            placeholderValues["nominal"] = "350.000";
            placeholderValues["resi"] = "JNE-987654321";
            RefreshPlaceholders();
            RefreshPreview();
        }
    }

    private async Task LoadTemplate(Clevora.Domain.Entities.MessageTemplate t)
    {
        templateBody = t.Body;
        RefreshPlaceholders();
        RefreshPreview();
        try
        {
            attachments = (await AttachmentService.GetByTemplateIdAsync(t.Id)).ToList();
        }
        catch { attachments.Clear(); }
    }

    private async Task OnTemplateSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id) && id > 0)
        {
            var t = await TemplateService.GetByIdAsync(id);
            if (t is not null) await LoadTemplate(t);
        }
        else
        {
            attachments.Clear();
        }
    }

    private void OnBodyInput(ChangeEventArgs e)
    {
        templateBody = e.Value?.ToString() ?? string.Empty;
        RefreshPlaceholders();
        RefreshPreview();
    }

    private void OnPlaceholderInput(string key, ChangeEventArgs e)
    {
        placeholderValues[key] = e.Value?.ToString() ?? string.Empty;
        RefreshPreview();
    }

    private void InsertFormatting(string marker)
    {
        templateBody = $"{templateBody} {marker}teks{marker} ";
        RefreshPlaceholders();
        RefreshPreview();
    }

    private void InsertAttachmentLink(AttachmentDto att)
    {
        if (!string.IsNullOrEmpty(att.DownloadUrl))
        {
            templateBody = $"{templateBody}\n📎 Unduh {att.FileName}: {att.DownloadUrl}";
            RefreshPlaceholders();
            RefreshPreview();
        }
    }

    private void RefreshPlaceholders()
    {
        placeholders = PlaceholderParser.ExtractNames(templateBody);
        foreach (var key in placeholders)
        {
            if (!placeholderValues.ContainsKey(key))
                placeholderValues[key] = string.Empty;
        }
    }

    private void RefreshPreview()
    {
        try
        {
            preview = ComposerService.Preview(templateBody, placeholderValues, recipientPhone);
        }
        catch { /* ignore preview errors */ }
    }

    private async Task RunAi(AiOperation op)
    {
        if (string.IsNullOrWhiteSpace(templateBody)) return;
        aiLoading = true;
        aiError = string.Empty;
        try
        {
            templateBody = await AiService.ProcessAsync(op, templateBody);
            RefreshPlaceholders();
            RefreshPreview();
        }
        catch (Exception ex)
        {
            aiError = $"AI error: {ex.Message}";
        }
        finally
        {
            aiLoading = false;
        }
    }

    private async Task CopyUrl()
    {
        copyStatus = "Tersalin!";
        StateHasChanged();
        await Task.Delay(2000);
        copyStatus = "Salin";
        StateHasChanged();
    }
}
