@page "/composer"
@using Clevora.Application.Interfaces
@using Clevora.Domain.Services
@using Clevora.Shared.Models
@using Microsoft.AspNetCore.Authorization
@inject IComposerService ComposerService
@inject ITemplateService TemplateService
@inject IAttachmentService AttachmentService
@inject IAiMessageService AiService

<PageTitle>Composer Workspace — Clevora</PageTitle>

<div class="composer-container">
    <div class="composer-header">
        <div>
            <h1>✏️ WhatsApp Message Composer</h1>
            <p class="subtitle">Susun template, isi placeholder dinamis, dan tinjau format WhatsApp secara instan.</p>
        </div>
        <div class="badge-status">
            <span class="dot-online"></span> Siap Kirim (Human-in-the-Loop)
        </div>
    </div>

    <div class="workspace-grid">
        <!-- Panel 1: Templates & Lampiran -->
        <div class="panel panel-sidebar">
            <div class="panel-title">
                <span>📁 Pustaka Cepat</span>
            </div>

            <label class="input-label">Pilih Template Siap Pakai:</label>
            <select class="form-select custom-select" @onchange="OnTemplateSelected">
                <option value="0">— Mulai dari pesan kosong —</option>
                @foreach (var t in templates)
                {
                    <option value="@t.Id">@(t.IsFavorite ? "⭐ " : "")@t.Title</option>
                }
            </select>

            <label class="input-label mt-3">Nomor Tujuan WhatsApp:</label>
            <div class="input-group">
                <span class="input-group-text">📱</span>
                <input class="form-control" @bind="recipientPhone" @bind:event="oninput" @onkeyup="RefreshPreview"
                       placeholder="Contoh: 08123456789 atau +628..." />
            </div>
            <small class="text-muted d-block mt-1">Otomatis dinormalisasi ke format internasional (E.164).</small>

            <hr class="my-3" />

            <div class="panel-title mb-2">
                <span>📎 Lampiran Dokumen</span>
            </div>
            @if (attachments.Any())
            {
                <div class="attachment-list">
                    @foreach (var att in attachments)
                    {
                        <div class="attachment-chip" @onclick="() => InsertAttachmentLink(att)">
                            <span>📄 @att.FileName</span>
                            <small class="badge bg-light text-dark">+ Sisipkan Link</small>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-muted small text-center py-3 bg-light rounded">
                    Tidak ada lampiran untuk template ini.
                </div>
            }
        </div>

        <!-- Panel 2: Editor & Placeholder Form -->
        <div class="panel panel-editor">
            <div class="panel-title d-flex justify-content-between align-items-center">
                <span>📝 Editor Pesan</span>
                <!-- Formatting Toolbar -->
                <div class="toolbar-btns">
                    <button type="button" class="btn-tool" title="Tebal (*teks*)" @onclick='() => InsertFormatting("*")'><strong>B</strong></button>
                    <button type="button" class="btn-tool" title="Miring (_teks_)" @onclick='() => InsertFormatting("_")'><em>I</em></button>
                    <button type="button" class="btn-tool" title="Coret (~teks~)" @onclick='() => InsertFormatting("~")'><s>S</s></button>
                    <button type="button" class="btn-tool font-monospace" title="Monospace (```teks```)" @onclick='() => InsertFormatting("```")'>&lt;/&gt;</button>
                </div>
            </div>

            <textarea rows="7" class="form-control custom-textarea mt-2"
                      value="@templateBody" @oninput="OnBodyInput"
                      placeholder="Tulis pesan Anda di sini... Gunakan {{nama_variabel}} untuk data dinamis. Contoh: Halo {{nama}}, pesanan Anda {{kode_pesanan}} sudah dikirim!"></textarea>

            <!-- Statistik Pesan -->
            <div class="metrics-bar d-flex justify-content-between align-items-center mt-2">
                <div class="d-flex gap-3 text-muted small">
                    <span>📊 <strong>@(preview?.CharacterCount ?? 0)</strong> Karakter</span>
                    <span>📝 <strong>@(preview?.WordCount ?? 0)</strong> Kata</span>
                </div>
                @if ((preview?.CharacterCount ?? 0) > 4000)
                {
                    <span class="badge bg-warning text-dark">Mendekati limit pesan panjang</span>
                }
            </div>

            <!-- Dynamic Placeholders Form -->
            @if (placeholders.Any())
            {
                <div class="placeholder-box mt-3">
                    <div class="placeholder-header">
                        <strong>🪄 Isi Nilai Placeholder Dinamis (@placeholders.Count variabel terdeteksi)</strong>
                    </div>
                    <div class="placeholder-grid mt-2">
                        @foreach (var key in placeholders)
                        {
                            <div class="placeholder-item">
                                <label class="placeholder-label">{{@key}}</label>
                                <input class="form-control form-control-sm"
                                       value="@placeholderValues[key]"
                                       @oninput="(e) => OnPlaceholderInput(key, e)"
                                       placeholder="Nilai untuk @key" />
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- AI Assistant Actions -->
            <div class="ai-box mt-3">
                <div class="d-flex align-items-center justify-content-between">
                    <span class="fw-semibold small text-success">🤖 Asisten Penulisan AI (Azure OpenAI)</span>
                    @if (aiLoading)
                    {
                        <span class="spinner-border spinner-border-sm text-success" role="status"></span>
                    }
                </div>
                <div class="d-flex gap-2 mt-2 flex-wrap">
                    <button class="btn btn-sm btn-outline-secondary" disabled="@aiLoading" @onclick="() => RunAi(AiOperation.Fix)">
                        🔧 Perbaiki Ejaan (Fix)
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@aiLoading" @onclick="() => RunAi(AiOperation.Rewrite)">
                        🔄 Tulis Ulang Profesional
                    </button>
                    <button class="btn btn-sm btn-success" disabled="@aiLoading" @onclick="() => RunAi(AiOperation.Compose)">
                        ✨ Compose AI (gpt-5.6-luna)
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(aiError))
                {
                    <div class="alert alert-danger py-1 px-2 mt-2 mb-0 small">@aiError</div>
                }
            </div>
        </div>

        <!-- Panel 3: Realistic WhatsApp Phone Mockup -->
        <div class="panel panel-preview">
            <div class="phone-frame">
                <!-- Phone Top Bar -->
                <div class="phone-notch"></div>
                <div class="wa-chat-header">
                    <div class="wa-avatar">🟢</div>
                    <div class="wa-chat-info">
                        <strong class="d-block text-white" style="font-size: 0.95rem;">
                            @(string.IsNullOrWhiteSpace(recipientPhone) ? "Penerima Pesan" : recipientPhone)
                        </strong>
                        <small class="text-white-50" style="font-size: 0.75rem;">online</small>
                    </div>
                </div>

                <!-- Chat Canvas with Wallpaper -->
                <div class="wa-chat-body">
                    <div class="wa-bubble-sent">
                        <div class="wa-text-content">
                            @if (preview is not null && !string.IsNullOrWhiteSpace(preview.HtmlPreview))
                            {
                                @((MarkupString)preview.HtmlPreview)
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Pratinjau pesan WhatsApp Anda akan tampil di sini secara real-time...</span>
                            }
                        </div>
                        <div class="wa-meta">
                            <span class="wa-time">@DateTime.Now.ToString("HH:mm")</span>
                            <span class="wa-ticks">✓✓</span>
                        </div>
                    </div>
                </div>

                <!-- Phone Bottom Bar -->
                <div class="wa-chat-footer">
                    <span class="text-muted small">🔒 Tinjau format sebelum mengirim</span>
                </div>
            </div>

            <!-- Action Area -->
            <div class="mt-3">
                @if (preview?.MissingPlaceholders.Count > 0)
                {
                    <div class="alert alert-warning py-2 small mb-2">
                        ⚠️ <strong>Perhatian:</strong> Masih ada placeholder belum diisi (@string.Join(", ", preview.MissingPlaceholders)).
                    </div>
                }

                @if (!string.IsNullOrEmpty(preview?.ClickToChatUrl))
                {
                    <div class="action-card p-3 rounded border bg-white shadow-sm">
                        <label class="small fw-bold text-muted d-block mb-1">🔗 WhatsApp Direct Link (wa.me):</label>
                        <div class="input-group mb-2">
                            <input class="form-control form-control-sm font-monospace" readonly value="@preview.ClickToChatUrl" />
                            <button class="btn btn-sm btn-outline-success" @onclick="CopyUrl">📋 @copyStatus</button>
                        </div>
                        <a href="@preview.ClickToChatUrl" target="_blank" class="btn btn-success w-100 fw-bold d-flex justify-content-center align-items-center gap-2">
                            <span>🚀 Buka Langsung di WhatsApp</span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

