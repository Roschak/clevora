@page "/favorites"
@using Clevora.Application.Interfaces
@using Clevora.Domain.Entities
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ITemplateService TemplateService
@inject NavigationManager Nav

<PageTitle>Favorit — Clevora</PageTitle>

<h2>⭐ Template Favorit</h2>

@if (templates is null) { <p>Memuat…</p> }
else if (!templates.Any()) { <div class="empty-state">Belum ada template favorit. Tandai template dengan ⭐ di halaman Template.</div> }
else
{
    <div class="template-grid">
        @foreach (var t in templates)
        {
            <div class="template-card favorited">
                <div class="tc-header">
                    <span class="tc-title">@t.Title</span>
                    <span class="tc-category">@(t.Category?.Name ?? "—")</span>
                </div>
                <div class="tc-body">@t.Body.Substring(0, Math.Min(t.Body.Length, 120))@(t.Body.Length > 120 ? "…" : "")</div>
                <div class="tc-actions">
                    <button class="btn-icon" @onclick="() => Nav.NavigateTo($\"/composer?tid={t.Id}\")">✏️ Buka di Composer</button>
                    <button class="btn-icon" @onclick="() => Remove(t)">☆ Hapus Favorit</button>
                </div>
            </div>
        }
    </div>
}

<style>
    .template-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; margin-top: 1rem; }
    .template-card.favorited { background: white; border: 1px solid #f59e0b; border-radius: 12px; padding: 1rem; }
    .tc-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; }
    .tc-title { font-weight: 700; }
    .tc-category { font-size: 0.75rem; background: #dcfce7; color: #166534; padding: 2px 8px; border-radius: 999px; }
    .tc-body { font-size: 0.85rem; color: #6b7280; white-space: pre-wrap; margin-bottom: 0.75rem; }
    .tc-actions { display: flex; gap: 0.5rem; }
    .btn-icon { background: none; border: none; cursor: pointer; font-size: 0.9rem; color: #374151; }
    .empty-state { text-align: center; color: #9ca3af; padding: 3rem; }
</style>

@code {
    private IReadOnlyList<MessageTemplate>? templates;

    protected override async Task OnInitializedAsync() =>
        templates = await TemplateService.GetFavoritesAsync();

    private async Task Remove(MessageTemplate t)
    {
        await TemplateService.ToggleFavoriteAsync(t.Id);
        templates = await TemplateService.GetFavoritesAsync();
    }
}
