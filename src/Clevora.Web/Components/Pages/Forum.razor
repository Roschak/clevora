@code {
    [Parameter] public int? ThreadId { get; set; }

    private readonly string[] categories = { "Semua", "📢 Pengumuman", "💡 Ide & Fitur", "🛠️ Q&A Teknis", "💬 Diskusi Komunitas" };
    private string activeCategory = "Semua";

    private List<ForumThreadDto> threads = [];
    private ForumThreadDto? selectedThread;
    private List<ForumCommentDto> comments = [];
    private string newCommentText = "";

    // New thread modal state
    private bool showCreateModal = false;
    private string newCategory = "💡 Ide & Fitur";
    private string newTitle = "";
    private string newContent = "";
    private string newTags = "";

    protected override void OnInitialized()
    {
        LoadThreads();
        if (ThreadId.HasValue && ThreadId.Value > 0)
        {
            var target = threads.FirstOrDefault(t => t.Id == ThreadId.Value);
            if (target != null) SelectThread(target);
        }
        else if (threads.Any())
        {
            SelectThread(threads.First());
        }
    }

    private void LoadThreads()
    {
        threads = ForumService.GetThreads(activeCategory).ToList();
    }

    private void FilterCategory(string cat)
    {
        activeCategory = cat;
        LoadThreads();
        if (selectedThread != null && !threads.Any(t => t.Id == selectedThread.Id))
        {
            selectedThread = threads.FirstOrDefault();
            if (selectedThread != null) SelectThread(selectedThread);
            else comments.Clear();
        }
    }

    private void SelectThread(ForumThreadDto t)
    {
        selectedThread = t;
        comments = ForumService.GetComments(t.Id).ToList();
        newCommentText = "";
    }

    private void ToggleUpvote(int threadId)
    {
        ForumService.ToggleUpvote(threadId);
        LoadThreads();
        if (selectedThread != null && selectedThread.Id == threadId)
        {
            selectedThread = ForumService.GetThread(threadId);
        }
    }

    private void SubmitComment()
    {
        if (selectedThread == null || string.IsNullOrWhiteSpace(newCommentText)) return;
        var author = CurrentUser.UserName ?? "Pengguna Web";
        ForumService.AddComment(new CreateForumCommentDto(selectedThread.Id, author, newCommentText.Trim()));
        comments = ForumService.GetComments(selectedThread.Id).ToList();
        selectedThread = ForumService.GetThread(selectedThread.Id);
        newCommentText = "";
        LoadThreads();
    }

    private void SubmitNewThread()
    {
        if (string.IsNullOrWhiteSpace(newTitle) || string.IsNullOrWhiteSpace(newContent)) return;
        var author = CurrentUser.UserName ?? "Pengguna Web";
        var created = ForumService.AddThread(new CreateForumThreadDto(newCategory, newTitle.Trim(), newContent.Trim(), newTags.Trim(), author));
        showCreateModal = false;
        newTitle = "";
        newContent = "";
        newTags = "";
        LoadThreads();
        SelectThread(created);
    }

    private string GetCategoryClass(string category)
    {
        if (category.Contains("Pengumuman")) return "web-cat-announcement";
        if (category.Contains("Ide")) return "web-cat-idea";
        if (category.Contains("Q&A") || category.Contains("Tanya")) return "web-cat-qa";
        return "web-cat-general";
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "WA";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }

    private string GetAvatarBg(string name)
    {
        string[] colors = { "#00A884", "#128C7E", "#25D366", "#0D9488", "#0284C7", "#7C3AED", "#DB2777" };
        int hash = Math.Abs(name.GetHashCode());
        return colors[hash % colors.Length];
    }

    private string FormatTime(DateTime dt)
    {
        var local = dt.ToLocalTime();
        if (local.Date == DateTime.Now.Date) return local.ToString("HH:mm");
        if (local.Date == DateTime.Now.Date.AddDays(-1)) return "Kemarin";
        return local.ToString("dd/MM/yy");
    }
}
