@page "/forum"
@page "/forum/{ThreadId:int}"
@using Clevora.Application.Interfaces
@using Clevora.Shared.Models
@using Clevora.Web.Services
@inject IForumWebService ForumService
@inject ICurrentUserService CurrentUser
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Forum Komunitas — Clevora</PageTitle>

<div class="web-forum-screen">
    <!-- Top Forum Hero Bar -->
    <header class="web-forum-hero">
        <div class="web-forum-hero-content">
            <div class="web-forum-hero-badge">COMMUNITY FORUM</div>
            <h1>Forum Komunitas Clevora</h1>
            <p>Terpisah &amp; berbeda dari chat grup: diskusi topik terstruktur, pengajuan ide fitur, dan tanya jawab teknis dengan sistem voting.</p>
        </div>
        <button class="web-btn-new-topic" @onclick="() => showCreateModal = true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
            </svg>
            <span>+ Buat Topik Baru</span>
        </button>
    </header>

    <!-- Category Filter Bar -->
    <div class="web-forum-category-bar">
        @foreach (var cat in categories)
        {
            <button class="web-cat-pill @(activeCategory == cat ? "active" : "")" 
                    @onclick="() => FilterCategory(cat)">
                @cat
            </button>
        }
    </div>

    <!-- Main Content: Threads List & Detail Split View -->
    <div class="web-forum-body">
        <!-- Threads Stream -->
        <div class="web-forum-threads-col">
            @if (threads.Count == 0)
            {
                <div class="web-forum-empty">
                    <div style="font-size:3rem;margin-bottom:8px;">💡</div>
                    <h3>Belum ada topik diskusi di kategori ini</h3>
                    <p>Jadilah yang pertama memulai pembahasan!</p>
                    <button class="web-btn-new-topic" style="margin-top:12px;" @onclick="() => showCreateModal = true">+ Buat Topik</button>
                </div>
            }
            else
            {
                @foreach (var t in threads)
                {
                    <div class="web-thread-card @(selectedThread?.Id == t.Id ? "selected" : "")" @onclick="() => SelectThread(t)">
                        <div class="web-thread-card-header">
                            <span class="web-thread-cat-badge @GetCategoryClass(t.Category)">@t.Category</span>
                            <span class="web-thread-time">@FormatTime(t.CreatedAt)</span>
                        </div>

                        <div class="web-thread-author-row">
                            <div class="web-avatar-sm" style="background:@GetAvatarBg(t.AuthorName)">
                                @GetInitials(t.AuthorName)
                            </div>
                            <span class="web-thread-author-name">@t.AuthorName</span>
                            @if (t.AuthorName.Contains("Fadhil") || t.AuthorName.Contains("Gravicode"))
                            {
                                <span class="web-dev-badge">★ DEV</span>
                            }
                        </div>

                        <h3 class="web-thread-title">@t.Title</h3>
                        <p class="web-thread-snippet">@t.Content</p>

                        @if (!string.IsNullOrWhiteSpace(t.Tags))
                        {
                            <div class="web-thread-tags">
                                @foreach (var tag in t.Tags.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="web-thread-tag">@tag</span>
                                }
                            </div>
                        }

                        <div class="web-thread-footer">
                            <button class="web-upvote-btn @(t.HasUpvoted ? "upvoted" : "")" 
                                    @onclick="() => ToggleUpvote(t.Id)" 
                                    @onclick:stopPropagation>
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                                    <path d="M12 4l-8 8h5v8h6v-8h5z"/>
                                </svg>
                                <span>▲ @t.Upvotes</span>
                            </button>

                            <div class="web-replies-count">
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                                    <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/>
                                </svg>
                                <span>@t.CommentCount balasan</span>
                            </div>

                            <span class="web-view-thread-link">Buka Diskusi →</span>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Thread Discussion Pane -->
        <div class="web-forum-detail-col">
            @if (selectedThread != null)
            {
                <div class="web-thread-detail-container">
                    <!-- Main Thread Post -->
                    <div class="web-thread-post-box">
                        <div class="web-thread-card-header">
                            <span class="web-thread-cat-badge @GetCategoryClass(selectedThread.Category)">@selectedThread.Category</span>
                            <span class="web-thread-time">Diposting @FormatTime(selectedThread.CreatedAt)</span>
                        </div>

                        <div class="web-thread-author-row" style="margin-top:10px;">
                            <div class="web-avatar-sm" style="width:36px;height:36px;font-size:0.9rem;background:@GetAvatarBg(selectedThread.AuthorName)">
                                @GetInitials(selectedThread.AuthorName)
                            </div>
                            <div>
                                <div style="font-weight:700;font-size:0.95rem;color:#1E293B;">
                                    @selectedThread.AuthorName
                                    @if (selectedThread.AuthorName.Contains("Fadhil") || selectedThread.AuthorName.Contains("Gravicode"))
                                    {
                                        <span class="web-dev-badge">★ DEV</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <h2 class="web-detail-title">@selectedThread.Title</h2>
                        <div class="web-detail-content">@selectedThread.Content</div>

                        @if (!string.IsNullOrWhiteSpace(selectedThread.Tags))
                        {
                            <div class="web-thread-tags" style="margin-top:14px;">
                                @foreach (var tag in selectedThread.Tags.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="web-thread-tag">@tag</span>
                                }
                            </div>
                        }

                        <div style="margin-top:16px;">
                            <button class="web-upvote-btn @(selectedThread.HasUpvoted ? "upvoted" : "")" 
                                    @onclick="() => ToggleUpvote(selectedThread.Id)">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                                    <path d="M12 4l-8 8h5v8h6v-8h5z"/>
                                </svg>
                                <span>▲ @selectedThread.Upvotes Dukungan Upvote</span>
                            </button>
                        </div>
                    </div>

                    <!-- Threaded Comments -->
                    <div class="web-comments-stream">
                        <div class="web-comments-header">
                            💬 Diskusi &amp; Balasan Komunitas (@comments.Count)
                        </div>

                        @if (comments.Count == 0)
                        {
                            <div style="text-align:center;padding:24px;color:#64748B;font-size:0.9rem;">
                                Belum ada balasan pada topik ini. Jadilah yang pertama memberikan pendapat atau jawaban!
                            </div>
                        }
                        else
                        {
                            @foreach (var c in comments)
                            {
                                <div class="web-comment-card">
                                    <div class="web-comment-author-row">
                                        <div class="web-avatar-sm" style="width:28px;height:28px;font-size:0.75rem;background:@GetAvatarBg(c.AuthorName)">
                                            @GetInitials(c.AuthorName)
                                        </div>
                                        <span style="font-weight:700;font-size:0.85rem;color:#1E293B;">@c.AuthorName</span>
                                        <span style="font-size:0.75rem;color:#94A3B8;margin-left:auto;">@FormatTime(c.CreatedAt)</span>
                                    </div>
                                    <div class="web-comment-content">
                                        @c.Content
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <!-- Bottom Reply Box -->
                    <div class="web-thread-reply-bar">
                        <input class="web-reply-input" 
                               placeholder="Tulis balasan atau masukan teknis..." 
                               @bind="newCommentText" 
                               @onkeyup='(e) => { if (e.Key == "Enter") SubmitComment(); }' />
                        <button class="web-reply-btn" @onclick="SubmitComment" disabled="@string.IsNullOrWhiteSpace(newCommentText)">
                            Balas
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="web-forum-empty" style="height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;">
                    <div style="font-size:3rem;margin-bottom:8px;">📋</div>
                    <h3>Pilih Topik Diskusi</h3>
                    <p>Klik salah satu topik di sisi kiri untuk membaca isi lengkap dan memberikan tanggapan.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Buat Topik Baru -->
@if (showCreateModal)
{
    <div class="web-modal-backdrop" @onclick="() => showCreateModal = false">
        <div class="web-forum-new-modal" @onclick:stopPropagation>
            <div class="web-forum-modal-header">
                <h3>📝 Buat Topik Forum Baru</h3>
                <button class="web-modal-close" @onclick="() => showCreateModal = false">✕</button>
            </div>
            <div class="web-forum-modal-body">
                <label class="web-form-label">Kategori Forum</label>
                <select class="web-form-select" @bind="newCategory">
                    <option value="📢 Pengumuman">📢 Pengumuman Resmi</option>
                    <option value="💡 Ide &amp; Fitur">💡 Ide &amp; Usulan Fitur</option>
                    <option value="🛠️ Q&amp;A Teknis">🛠️ Tanya Jawab / Q&amp;A Teknis</option>
                    <option value="💬 Diskusi Komunitas">💬 Diskusi Komunitas &amp; Santai</option>
                </select>

                <label class="web-form-label" style="margin-top:12px;">Judul Topik</label>
                <input class="web-form-input" @bind="newTitle" placeholder="Contoh: Best Practice EF Core & SQLite WAL di .NET 10" />

                <label class="web-form-label" style="margin-top:12px;">Isi / Konten Diskusi</label>
                <textarea class="web-form-textarea" @bind="newContent" placeholder="Jelaskan gagasan atau pertanyaan Anda secara rinci..."></textarea>

                <label class="web-form-label" style="margin-top:12px;">Tagar (Opsional)</label>
                <input class="web-form-input" @bind="newTags" placeholder="Contoh: #dotnet10 #sqlite #cleanarchitecture" />

                <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:18px;">
                    <button class="web-btn-secondary" @onclick="() => showCreateModal = false">Batal</button>
                    <button class="web-btn-new-topic" @onclick="SubmitNewThread" disabled="@(string.IsNullOrWhiteSpace(newTitle) || string.IsNullOrWhiteSpace(newContent))">
                        🚀 Publikasikan Topik
                    </button>
                </div>
            </div>
        </div>
    </div>
}

