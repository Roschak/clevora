@page "/not-found"
@layout MainLayout
@inject NavigationManager Nav

@code {
    protected override void OnInitialized()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        // If an account/identity or server-rendered route is hit interactively, force browser reload to it
        if (relative.StartsWith("Account/", StringComparison.OrdinalIgnoreCase) ||
            relative.Equals("Account", StringComparison.OrdinalIgnoreCase) ||
            relative.Equals("login", StringComparison.OrdinalIgnoreCase) ||
            relative.Equals("register", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("/" + relative.TrimStart('/'), forceLoad: true);
        }
    }
}

<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;min-height:360px;padding:32px;text-align:center;">
    <div style="font-size:3.5rem;margin-bottom:12px;">💬</div>
    <h3 style="color:#008069;font-weight:700;margin-bottom:8px;">Percakapan Tidak Ditemukan</h3>
    <p style="color:#64748B;font-size:0.95rem;max-width:400px;margin-bottom:20px;">
        Percakapan atau konten yang Anda cari tidak tersedia. Silakan pilih percakapan lain di sidebar.
    </p>
    <a href="/" class="btn text-white px-4 py-2" style="background:#008069;border-radius:8px;font-weight:600;text-decoration:none;">
        ← Kembali ke Chat
    </a>
</div>