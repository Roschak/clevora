@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Clevora — Chat</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="chat-welcome">
            <div class="chat-welcome-inner">
                <div class="chat-welcome-logo">C</div>
                <h2 class="chat-welcome-title">Selamat datang di Clevora WhatsApp</h2>
                <p class="chat-welcome-desc">Pilih percakapan di sidebar atau mulai chat baru untuk memulai obrolan.</p>
                <p class="chat-welcome-credit">Dibuat oleh <strong>Gravicode Studios</strong> dipimpin oleh <em>Kang Fadhil</em></p>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="chat-welcome" style="padding:20px;">
            <div class="chat-welcome-inner" style="max-width:500px;background:white;padding:32px 28px;border-radius:16px;box-shadow:0 4px 20px rgba(0,0,0,0.08);border:1px solid #E2E8F0;text-align:center;">
                <div class="chat-welcome-logo" style="margin:0 auto 14px;">C</div>
                <h2 class="chat-welcome-title" style="color:#008069;margin-bottom:8px;font-size:1.4rem;">Clevora WhatsApp Web</h2>
                <p class="chat-welcome-desc" style="margin-bottom:20px;font-size:0.9rem;color:#64748B;">Platform Chat Real-time + WhatsApp Experience &amp; AI Copilot</p>
                
                <div style="display:flex;flex-direction:column;gap:10px;text-align:left;">
                    <button type="button" @onclick="GoToLogin" class="btn text-white py-2" style="background:#008069;font-weight:600;text-align:center;border-radius:8px;border:none;cursor:pointer;width:100%;">
                        🟢 Masuk ke Akun / Demo Chat
                    </button>
                    <button type="button" @onclick="GoToRegister" class="btn btn-outline-secondary py-2" style="font-weight:600;text-align:center;border-radius:8px;cursor:pointer;width:100%;">
                        Daftar Akun Baru
                    </button>
                </div>

                <!-- Opsi Masuk Cepat 1-Klik Langsung -->
                <div style="margin-top:20px;padding-top:16px;border-top:1px dashed #E2E8F0;text-align:left;">
                    <div style="font-size:0.75rem;color:#64748B;font-weight:700;margin-bottom:10px;text-transform:uppercase;letter-spacing:0.5px;display:flex;align-items:center;gap:6px;">
                        <span>⚡ Masuk Cepat Langsung (1-Klik):</span>
                    </div>
                    <div style="display:flex;gap:8px;">
                        <form method="post" action="/Account/QuickLogin" style="flex:1;margin:0;">
                            <input type="hidden" name="email" value="fadhil@gravicode.com" />
                            <button type="submit" class="btn btn-sm text-white py-2 w-100" style="background:#059669;font-size:0.85rem;font-weight:600;border-radius:8px;border:none;cursor:pointer;">
                                👤 Kang Fadhil
                            </button>
                        </form>
                        <form method="post" action="/Account/QuickLogin" style="flex:1;margin:0;">
                            <input type="hidden" name="email" value="user@clevora.com" />
                            <button type="submit" class="btn btn-sm text-white py-2 w-100" style="background:#0284C7;font-size:0.85rem;font-weight:600;border-radius:8px;border:none;cursor:pointer;">
                                👥 Pengguna Demo
                            </button>
                        </form>
                    </div>
                </div>

                <p class="chat-welcome-credit" style="margin-top:24px;font-size:0.8rem;color:#94A3B8;">Dibuat oleh <strong>Gravicode Studios</strong> dipimpin oleh <em>Kang Fadhil</em></p>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private void GoToLogin()
    {
        NavigationManager.NavigateTo("/Account/Login", forceLoad: true);
    }

    private void GoToRegister()
    {
        NavigationManager.NavigateTo("/Account/Register", forceLoad: true);
    }
}
