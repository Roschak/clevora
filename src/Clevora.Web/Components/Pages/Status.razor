@page "/status"
@using Clevora.Application.Interfaces
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Status — Clevora</PageTitle>

<div class="web-status-screen">
    <!-- Left Sidebar: Status List -->
    <div class="web-status-sidebar">
        <div class="web-status-header">
            <h2>Status</h2>
            <button class="web-btn-add-status" @onclick="() => showCreateModal = true" title="Buat Status Baru">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                    <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                </svg>
                <span>Status Baru</span>
            </button>
        </div>

        <div class="web-status-scroll">
            <!-- My Status -->
            <div class="web-status-item my-status" @onclick="HandleMyStatusClick">
                <div class="web-status-avatar-ring @(myStatus != null ? "active" : "")">
                    <div class="web-status-avatar" style="background:@(myStatus?.ColorBg ?? "#008069")">
                        S
                    </div>
                    <span class="web-status-plus-badge">+</span>
                </div>
                <div class="web-status-meta">
                    <div class="web-status-name">Status saya</div>
                    <div class="web-status-time">
                        @(myStatus != null ? $"Hari ini, {myStatus.TimeAgo}" : "Ketuk untuk menambahkan pembaruan status")
                    </div>
                </div>
            </div>

            <div class="web-status-divider">PEMBARUAN TERKINI</div>

            @foreach (var st in statuses.Where(s => !s.IsViewed))
            {
                <div class="web-status-item @(activeStatus?.Id == st.Id ? "selected" : "")" @onclick="() => SelectStatus(st)">
                    <div class="web-status-avatar-ring active">
                        <div class="web-status-avatar" style="background:@st.ColorBg">
                            @GetInitials(st.UserName)
                        </div>
                    </div>
                    <div class="web-status-meta">
                        <div class="web-status-name">@st.UserName</div>
                        <div class="web-status-time">@st.TimeAgo</div>
                    </div>
                </div>
            }

            @if (statuses.Any(s => s.IsViewed))
            {
                <div class="web-status-divider">PEMBARUAN YANG TELAH DILIHAT</div>
                @foreach (var st in statuses.Where(s => s.IsViewed))
                {
                    <div class="web-status-item viewed @(activeStatus?.Id == st.Id ? "selected" : "")" @onclick="() => SelectStatus(st)">
                        <div class="web-status-avatar-ring viewed">
                            <div class="web-status-avatar" style="background:@st.ColorBg">
                                @GetInitials(st.UserName)
                            </div>
                        </div>
                        <div class="web-status-meta">
                            <div class="web-status-name">@st.UserName</div>
                            <div class="web-status-time">@st.TimeAgo</div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Right Main Area: Status Viewer -->
    <div class="web-status-main">
        @if (activeStatus != null)
        {
            <div class="web-story-viewer" style="background:@activeStatus.ColorBg">
                <!-- Top Progress Bar -->
                <div class="web-story-progress-bar">
                    <div class="web-story-progress-fill" style="width:@(progress)%;"></div>
                </div>

                <!-- Story Header -->
                <div class="web-story-header">
                    <div class="web-story-user-info">
                        <div class="web-status-avatar" style="width:40px;height:40px;background:rgba(255,255,255,0.25);">
                            @GetInitials(activeStatus.UserName)
                        </div>
                        <div>
                            <div class="web-story-author">@activeStatus.UserName</div>
                            <div class="web-story-time">@activeStatus.TimeAgo</div>
                        </div>
                    </div>
                    <button class="web-story-close-btn" @onclick="CloseViewer">✕</button>
                </div>

                <!-- Story Canvas / Body -->
                <div class="web-story-body">
                    <button class="web-story-nav-btn prev" @onclick="PrevStatus" title="Sebelumnya">‹</button>
                    <div class="web-story-card">
                        <div class="web-story-text">
                            @activeStatus.Content
                        </div>
                    </div>
                    <button class="web-story-nav-btn next" @onclick="NextStatus" title="Selanjutnya">›</button>
                </div>

                <!-- Reply Bar -->
                <div class="web-story-reply-bar">
                    <input class="web-story-reply-input" 
                           placeholder="Balas status ke @activeStatus.UserName..." 
                           @bind="replyMessage" 
                           @onkeyup='(e) => { if (e.Key == "Enter") SendReply(); }' />
                    <button class="web-story-send-btn" @onclick="SendReply" title="Kirim Balasan">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="white">
                            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                        </svg>
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="web-status-empty">
                <div class="web-status-empty-icon">
                    <svg viewBox="0 0 24 24" width="80" height="80" fill="none" stroke="#94A3B8" stroke-width="1.5">
                        <circle cx="12" cy="12" r="10" stroke-dasharray="4 4"/>
                        <circle cx="12" cy="12" r="4"/>
                    </svg>
                </div>
                <h3>Pilih kontak untuk melihat pembaruan status</h3>
                <p>Status WhatsApp terenkripsi end-to-end dan akan hilang setelah 24 jam.</p>
            </div>
        }
    </div>
</div>

<!-- Modal: Buat Status Baru -->
@if (showCreateModal)
{
    <div class="web-modal-backdrop" @onclick="() => showCreateModal = false">
        <div class="web-modal-box" style="background:@newStatusBg" @onclick:stopPropagation>
            <div class="web-modal-top">
                <button class="web-modal-close" @onclick="() => showCreateModal = false">✕</button>
                <div class="web-color-palette">
                    @foreach (var c in colorPalette)
                    {
                        <span class="web-palette-dot @(newStatusBg == c ? "active" : "")" 
                              style="background:@c" 
                              @onclick="() => newStatusBg = c"></span>
                    }
                </div>
            </div>

            <textarea class="web-status-textarea" 
                      placeholder="Ketik status teks Anda di sini..." 
                      @bind="newStatusContent" 
                      autofocus></textarea>

            <div class="web-modal-bottom">
                <button class="web-btn-share-status" @onclick="PublishStatus">
                    Bagikan ke Status 🚀
                </button>
            </div>
        </div>
    </div>
}

