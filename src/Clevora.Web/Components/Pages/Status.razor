@code {
    public class StatusItem
    {
        public int Id { get; set; }
        public string UserName { get; set; } = "";
        public string Content { get; set; } = "";
        public string ColorBg { get; set; } = "#075E54";
        public string TimeAgo { get; set; } = "";
        public bool IsViewed { get; set; }
        public bool IsMine { get; set; }
    }

    private List<StatusItem> statuses = new()
    {
        new() { Id = 1, UserName = "Kang Fadhil (Gravicode Studios)", Content = "🚀 Rilis Clevora v1.0! Clean Architecture, .NET 10 LTS MAUI Blazor Hybrid & SQLite Offline-First.", ColorBg = "#075E54", TimeAgo = "25 menit yang lalu", IsViewed = false },
        new() { Id = 2, UserName = "Siti Nurhaliza", Content = "Desain WhatsApp UI dan Clevora AI Copilot sudah terintegrasi rapi ✨ Nyaman digunakan seharian!", ColorBg = "#BE185D", TimeAgo = "1 jam yang lalu", IsViewed = false },
        new() { Id = 3, UserName = "Budi Santoso", Content = "Prinsip Human-in-the-Loop: pengguna memegang kendali penuh atas setiap pesan yang dikirimkan 🤝", ColorBg = "#1E40AF", TimeAgo = "4 jam yang lalu", IsViewed = true },
        new() { Id = 4, UserName = "Iruzzz67", Content = "Infrastruktur cloud Azure VM Ubuntu, Nginx HTTPS reverse proxy, dan SignalR hub aktif normal 🌐", ColorBg = "#047857", TimeAgo = "6 jam yang lalu", IsViewed = true }
    };

    private StatusItem? myStatus;
    private StatusItem? activeStatus;
    private double progress = 0;
    private System.Threading.Timer? progressTimer;
    private string replyMessage = "";

    // Create modal state
    private bool showCreateModal = false;
    private string newStatusContent = "";
    private string newStatusBg = "#075E54";
    private readonly string[] colorPalette = { "#075E54", "#1E40AF", "#7C3AED", "#BE185D", "#047857", "#374151" };

    protected override void OnInitialized()
    {
        if (statuses.Any())
        {
            SelectStatus(statuses.First());
        }
    }

    private void SelectStatus(StatusItem st)
    {
        progressTimer?.Dispose();
        activeStatus = st;
        st.IsViewed = true;
        progress = 0;

        progressTimer = new System.Threading.Timer(_ =>
        {
            progress += 2;
            if (progress >= 100)
            {
                InvokeAsync(NextStatus);
            }
            else
            {
                InvokeAsync(StateHasChanged);
            }
        }, null, 100, 100);
    }

    private void HandleMyStatusClick()
    {
        if (myStatus != null)
        {
            SelectStatus(myStatus);
        }
        else
        {
            showCreateModal = true;
        }
    }

    private void NextStatus()
    {
        if (activeStatus == null) return;
        var idx = statuses.IndexOf(activeStatus);
        if (idx < statuses.Count - 1)
        {
            SelectStatus(statuses[idx + 1]);
        }
        else
        {
            CloseViewer();
        }
    }

    private void PrevStatus()
    {
        if (activeStatus == null) return;
        var idx = statuses.IndexOf(activeStatus);
        if (idx > 0)
        {
            SelectStatus(statuses[idx - 1]);
        }
    }

    private void CloseViewer()
    {
        progressTimer?.Dispose();
        progressTimer = null;
        activeStatus = null;
        StateHasChanged();
    }

    private void SendReply()
    {
        if (string.IsNullOrWhiteSpace(replyMessage) || activeStatus == null) return;
        // Navigate to chat
        Nav.NavigateTo("/chat");
    }

    private void PublishStatus()
    {
        if (string.IsNullOrWhiteSpace(newStatusContent)) return;
        myStatus = new StatusItem
        {
            Id = 999,
            UserName = "Status Saya",
            Content = newStatusContent.Trim(),
            ColorBg = newStatusBg,
            TimeAgo = "Baru saja",
            IsViewed = true,
            IsMine = true
        };
        showCreateModal = false;
        newStatusContent = "";
        SelectStatus(myStatus);
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "WA";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }
}
