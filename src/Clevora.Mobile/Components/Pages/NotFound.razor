@page "/not-found"
@layout MainLayout
@inject NavigationManager Nav

<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100vh;padding:24px;text-align:center;background:#F0F2F5;">
    <div style="font-size:3.5rem;margin-bottom:14px;">💬</div>
    <h3 style="color:#008069;font-weight:700;margin-bottom:8px;">Percakapan Tidak Ditemukan</h3>
    <p style="color:#667781;font-size:0.9rem;max-width:320px;margin-bottom:20px;">
        Percakapan atau obrolan grup yang Anda cari tidak tersedia.
    </p>
    <button style="background:#008069;color:white;border:none;padding:10px 24px;border-radius:24px;font-weight:600;cursor:pointer;font-size:0.95rem;box-shadow:0 2px 6px rgba(0,0,0,0.15);" @onclick='() => Nav.NavigateTo("/")'>
        ← Kembali ke WhatsApp
    </button>
</div>
