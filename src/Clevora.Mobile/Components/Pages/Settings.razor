    overflow: hidden;
    text-overflow: ellipsis;
}

.wa-profile-status {
    font-size: 0.85rem;
    color: #667781;
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.wa-profile-qr {
    padding: 6px;
}

.wa-settings-list {
    background: white;
    margin-top: 8px;
    border-top: 1px solid #E9EDEF;
    border-bottom: 1px solid #E9EDEF;
}

.wa-settings-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 16px;
    border-bottom: 1px solid #F0F2F5;
    cursor: pointer;
    transition: background 0.15s ease;
}

.wa-settings-item:last-child {
    border-bottom: none;
}

.wa-settings-item:active {
    background: #F0F2F5;
}

.wa-settings-icon {
    width: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.wa-settings-item-info {
    flex: 1;
}

.wa-settings-item-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: #111B21;
}

.wa-settings-item-desc {
    font-size: 0.8rem;
    color: #667781;
    margin-top: 2px;
    line-height: 1.25;
}

.wa-settings-footer {
    text-align: center;
    padding: 24px 16px;
}

/* Sub-screen styles */
.wa-subscreen {
    padding: 16px;
}

.wa-section-header {
    font-size: 0.8rem;
    font-weight: 700;
    color: #008069;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 16px 0 8px;
}

.wa-setting-tile {
    background: white;
    border-radius: 8px;
    padding: 12px 14px;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    cursor: pointer;
}

.wa-tile-text {
    flex: 1;
    margin-right: 12px;
}

.wa-tile-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: #111B21;
}

.wa-tile-sub {
    font-size: 0.8rem;
    color: #667781;
    margin-top: 2px;
}

.wa-card-section {
    background: white;
    border-radius: 8px;
    padding: 14px;
    margin-bottom: 12px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
}

.wa-label-sm {
    font-size: 0.75rem;
    font-weight: 700;
    color: #54656F;
    text-transform: uppercase;
    margin-bottom: 6px;
