@code {
    private string activeSubScreen = "";
    private string subScreenTitle = "";
    private bool showSearch = false;
    private string searchFilter = "";

    // Toast feedback
    private bool showToast = false;
    private string toastMessage = "";

    // 1. Profil state
    private string currentUserName = "Kang Fadhil (Gravicode Studios)";
    private string userBio = "Ada";
    private string userPhone = "+62 812-3456-7890";
    private string userSocialLink = "https://gravicode.com";

    // 2. Akun state
    private string currentUserEmail = "fadhil@gravicode.com";
    private bool securityNotifications = true;

    // 3. Privasi state
    private string privacyLastSeen = "Semua Orang";
    private string privacyProfilePhoto = "Kontak Saya";
    private string privacyInfo = "Semua Orang";
    private string privacyStatus = "Kontak Saya";
    private bool readReceipts = true;
    private string defaultMessageTimer = "Mati";
    private bool silenceUnknownCallers = false;
    private bool appLockEnabled = false;

    // 4. Daftar
    private string newListName = "";

    // 5. Chat
    private string appTheme = "Terang";
    private bool enterIsSend = true;
    private bool mediaVisibility = true;
    private bool keepArchived = true;
    private bool voiceTranscripts = true;

    // 6. Notifikasi
    private bool convTones = true;
    private bool reactionNotifs = true;

    // 7. Penyimpanan & Data
    private string mediaQuality = "Kualitas HD";
    private bool lowDataUsage = false;

    // 8. Bahasa
    private string selectedLanguage = "Bahasa Indonesia";

    // 9. Pembaruan
    private bool autoUpdateWifi = true;

    // 10. Server Sync
    private string serverUrl = "http://localhost:5000";
    private string serverToken = "";

    protected override void OnInitialized()
    {
        currentUserName = Db.GetState("CurrentUserName") ?? "Kang Fadhil (Gravicode Studios)";
        currentUserEmail = Db.GetState("CurrentUserEmail") ?? "fadhil@gravicode.com";
        userBio = Db.GetState("UserBio") ?? "Ada";
        userPhone = Db.GetState("UserPhone") ?? "+62 812-3456-7890";
        userSocialLink = Db.GetState("UserSocialLink") ?? "https://gravicode.com";

        privacyLastSeen = Db.GetState("PrivacyLastSeen") ?? "Semua Orang";
        privacyProfilePhoto = Db.GetState("PrivacyProfilePhoto") ?? "Kontak Saya";
        privacyInfo = Db.GetState("PrivacyInfo") ?? "Semua Orang";
        privacyStatus = Db.GetState("PrivacyStatus") ?? "Kontak Saya";
        readReceipts = (Db.GetState("ReadReceipts") ?? "true") == "true";
        defaultMessageTimer = Db.GetState("DefaultMessageTimer") ?? "Mati";
        silenceUnknownCallers = (Db.GetState("SilenceUnknownCallers") ?? "false") == "true";
        appLockEnabled = (Db.GetState("AppLockEnabled") ?? "false") == "true";

        appTheme = Db.GetState("AppTheme") ?? "Terang";
        enterIsSend = (Db.GetState("EnterIsSend") ?? "true") == "true";
        mediaVisibility = (Db.GetState("MediaVisibility") ?? "true") == "true";
        keepArchived = (Db.GetState("KeepArchived") ?? "true") == "true";
        voiceTranscripts = (Db.GetState("VoiceTranscripts") ?? "true") == "true";

        convTones = (Db.GetState("ConvTones") ?? "true") == "true";
        reactionNotifs = (Db.GetState("ReactionNotifs") ?? "true") == "true";

        mediaQuality = Db.GetState("MediaQuality") ?? "Kualitas HD";
        lowDataUsage = (Db.GetState("LowDataUsage") ?? "false") == "true";

        selectedLanguage = Db.GetState("SelectedLanguage") ?? "Bahasa Indonesia";
        autoUpdateWifi = (Db.GetState("AutoUpdateWifi") ?? "true") == "true";

        serverUrl = Db.GetState("ServerUrl") ?? "http://localhost:5000";
        serverToken = Db.GetState("Token") ?? "";
    }

    private void HandleBack()
    {
        if (!string.IsNullOrEmpty(activeSubScreen))
        {
            activeSubScreen = "";
            subScreenTitle = "";
        }
        else
        {
            Nav.NavigateTo("/");
        }
    }

    private void OpenSubScreen(string key, string title)
    {
        activeSubScreen = key;
        subScreenTitle = title;
    }

    private bool MatchesFilter(string title, string desc)
    {
        if (string.IsNullOrWhiteSpace(searchFilter)) return true;
        var q = searchFilter.Trim().ToLowerInvariant();
        return title.ToLowerInvariant().Contains(q) || desc.ToLowerInvariant().Contains(q);
    }

    private void SaveProfile()
    {
        Db.SetState("CurrentUserName", currentUserName);
        Db.SetState("UserBio", userBio);
        Db.SetState("UserPhone", userPhone);
        Db.SetState("UserSocialLink", userSocialLink);
        NotifyToast("Profil berhasil diperbarui!");
    }

    private void SaveAccountSettings()
    {
        Db.SetState("CurrentUserEmail", currentUserEmail);
        Db.SetState("SecurityNotifications", securityNotifications.ToString());
        NotifyToast("Setelan akun disimpan.");
    }

    private void CyclePrivacy(string field)
    {
        string[] options = ["Semua Orang", "Kontak Saya", "Tidak Ada"];
        if (field == "lastSeen")
        {
            privacyLastSeen = NextOption(privacyLastSeen, options);
            Db.SetState("PrivacyLastSeen", privacyLastSeen);
        }
        else if (field == "profilePhoto")
        {
            privacyProfilePhoto = NextOption(privacyProfilePhoto, options);
            Db.SetState("PrivacyProfilePhoto", privacyProfilePhoto);
        }
        else if (field == "info")
        {
            privacyInfo = NextOption(privacyInfo, options);
            Db.SetState("PrivacyInfo", privacyInfo);
        }
        else if (field == "status")
        {
            privacyStatus = NextOption(privacyStatus, options);
            Db.SetState("PrivacyStatus", privacyStatus);
        }
        NotifyToast("Privasi diperbarui.");
    }

    private void CycleTimer()
    {
        string[] options = ["Mati", "24 Jam", "7 Hari", "90 Hari"];
        defaultMessageTimer = NextOption(defaultMessageTimer, options);
        Db.SetState("DefaultMessageTimer", defaultMessageTimer);
        NotifyToast($"Timer pesan default: {defaultMessageTimer}");
    }

    private string NextOption(string current, string[] options)
    {
        var idx = Array.IndexOf(options, current);
        if (idx == -1 || idx >= options.Length - 1) return options[0];
        return options[idx + 1];
    }

    private void SavePrivacySettings()
    {
        Db.SetState("ReadReceipts", readReceipts.ToString());
        Db.SetState("SilenceUnknownCallers", silenceUnknownCallers.ToString());
        Db.SetState("AppLockEnabled", appLockEnabled.ToString());
        NotifyToast("Setelan privasi diperbarui.");
    }

    private void CycleTheme()
    {
        string[] themes = ["Terang", "Gelap", "Default Sistem"];
        appTheme = NextOption(appTheme, themes);
        Db.SetState("AppTheme", appTheme);
        NotifyToast($"Tema diubah ke {appTheme}");
    }

    private void SaveChatSettings()
    {
        Db.SetState("EnterIsSend", enterIsSend.ToString());
        Db.SetState("MediaVisibility", mediaVisibility.ToString());
        Db.SetState("KeepArchived", keepArchived.ToString());
        Db.SetState("VoiceTranscripts", voiceTranscripts.ToString());
        NotifyToast("Setelan chat diperbarui.");
    }

    private void SaveNotifSettings()
    {
        Db.SetState("ConvTones", convTones.ToString());
        Db.SetState("ReactionNotifs", reactionNotifs.ToString());
        NotifyToast("Setelan notifikasi diperbarui.");
    }

    private void CycleMediaQuality()
    {
        string[] qualities = ["Kualitas Standar", "Kualitas HD"];
        mediaQuality = NextOption(mediaQuality, qualities);
        Db.SetState("MediaQuality", mediaQuality);
        NotifyToast($"Kualitas media: {mediaQuality}");
    }

    private void SaveStorageSettings()
    {
        Db.SetState("LowDataUsage", lowDataUsage.ToString());
        NotifyToast("Setelan penyimpanan diperbarui.");
    }

    private void SelectLanguage(string lang)
    {
        selectedLanguage = lang;
        Db.SetState("SelectedLanguage", selectedLanguage);
        NotifyToast($"Bahasa disetel ke {selectedLanguage}");
    }

    private void SaveUpdateSettings()
    {
        Db.SetState("AutoUpdateWifi", autoUpdateWifi.ToString());
        NotifyToast("Setelan pembaruan diperbarui.");
    }

    private async Task SaveServerConfig()
    {
        Db.SetState("ServerUrl", serverUrl);
        Db.SetState("Token", serverToken);
        ChatClient.Configure(serverUrl, serverToken);
        await ChatClient.ConnectAsync();
        NotifyToast("Server tersimpan & SignalR terhubung.");
    }

    private void AddNewList()
    {
        if (string.IsNullOrWhiteSpace(newListName)) return;
        NotifyToast($"Daftar '{newListName}' berhasil dibuat!");
        newListName = "";
    }

    private void ShowAlert(string msg)
    {
        NotifyToast(msg);
    }

    private void NotifyToast(string msg)
    {
        toastMessage = msg;
        showToast = true;
        _ = Task.Run(async () =>
        {
            await Task.Delay(2500);
            showToast = false;
            await InvokeAsync(StateHasChanged);
        });
        StateHasChanged();
    }
}
