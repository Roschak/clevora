@page "/templates"
@using Clevora.Mobile.Services
@inject LocalDatabaseService LocalDb
@inject NavigationManager Nav

<div class="mobile-templates p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="m-0 fw-bold">📋 Template Saya</h4>
        <button class="btn btn-sm btn-success" @onclick="() => showForm = !showForm">
            @(showForm ? "✕ Batal" : "+ Buat Baru")
        </button>
    </div>

    <!-- Category filter chips -->
    <div class="d-flex gap-2 mb-3 overflow-auto pb-1">
        <button class="btn btn-sm @(selectedCategory == null ? "btn-success" : "btn-outline-secondary")"
                @onclick="() => FilterCategory(null)">Semua</button>
        @foreach (var cat in categories)
        {
            <button class="btn btn-sm @(selectedCategory == cat.Id ? "btn-success" : "btn-outline-secondary") text-nowrap"
                    @onclick="() => FilterCategory(cat.Id)">
                @(cat.Icon ?? "📁") @cat.Name
            </button>
        }
    </div>

    <!-- Create form -->
    @if (showForm)
    {
        <div class="card p-3 mb-3 border shadow-sm">
            <h6 class="fw-bold mb-2">@(editId.HasValue ? "Edit Template" : "Buat Template Offline")</h6>
            <div class="mb-2">
                <input class="form-control form-control-sm" placeholder="Judul template..."
                       @bind="formTitle" />
            </div>
            <div class="mb-2">
                <select class="form-select form-select-sm" @bind="formCategoryId">
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id">@c.Icon @c.Name</option>
                    }
                </select>
            </div>
            <div class="mb-2">
                <textarea class="form-control form-control-sm" rows="4"
                          placeholder="Isi template dengan {{placeholder}}..."
                          @bind="formBody"></textarea>
            </div>
            @if (!string.IsNullOrEmpty(formError))
            {
                <p class="text-danger small">@formError</p>
            }
            <button class="btn btn-sm btn-success w-100" @onclick="SaveTemplate">
                💾 Simpan ke HP
            </button>
        </div>
    }

    <!-- Template list -->
    @if (!templates.Any())
    {
        <div class="text-center text-muted py-5">
            <div style="font-size:2.5rem">📋</div>
            <p class="mt-2">Belum ada template.<br />Ketuk <strong>+ Buat Baru</strong> untuk mulai.</p>
        </div>
    }
    else
    {
        <div class="template-list d-flex flex-column gap-2">
            @foreach (var t in templates)
            {
                <div class="card p-2 border shadow-sm">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <strong class="small">@t.Title</strong>
                        <div class="d-flex gap-1">
                            <button class="btn btn-sm py-0 px-1 border-0" @onclick="() => ToggleFav(t.Id)">
                                @(t.IsFavorite ? "⭐" : "☆")
                            </button>
                            <button class="btn btn-sm py-0 px-1 border-0" @onclick="() => EditTemplate(t)">✏️</button>
                            <button class="btn btn-sm py-0 px-1 border-0" @onclick="() => OpenComposer(t.Id)">🚀</button>
                        </div>
                    </div>
                    <p class="text-muted small m-0 text-truncate">@t.Body</p>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<LocalCategory> categories = [];
    private List<LocalTemplate> templates = [];
    private int? selectedCategory;
    private bool showForm;
    private int? editId;
    private string formTitle = string.Empty;
    private string formBody = string.Empty;
    private int formCategoryId;
    private string formError = string.Empty;

    protected override void OnInitialized() => RefreshData();

    private void RefreshData()
    {
        categories = LocalDb.GetCategories().ToList();
        templates = LocalDb.GetTemplates(selectedCategory).ToList();
        if (formCategoryId == 0 && categories.Any())
            formCategoryId = categories.First().Id;
    }

    private void FilterCategory(int? catId)
    {
        selectedCategory = catId;
        RefreshData();
    }

    private void ToggleFav(int id)
    {
        LocalDb.ToggleFavorite(id);
        RefreshData();
    }

    private void EditTemplate(LocalTemplate t)
    {
        editId = t.Id;
        formTitle = t.Title;
        formBody = t.Body;
        formCategoryId = t.CategoryId;
        formError = string.Empty;
        showForm = true;
    }

    private void OpenComposer(int id) =>
        Nav.NavigateTo("/composer/" + id);

    private void SaveTemplate()
    {
        formError = string.Empty;
        if (string.IsNullOrWhiteSpace(formTitle)) { formError = "Judul wajib diisi."; return; }
        if (string.IsNullOrWhiteSpace(formBody)) { formError = "Isi template wajib diisi."; return; }
        if (formCategoryId == 0) { formError = "Pilih kategori."; return; }

        LocalDb.SaveTemplate(formTitle, formBody, formCategoryId, null, editId);
        formTitle = string.Empty;
        formBody = string.Empty;
        editId = null;
        showForm = false;
        RefreshData();
    }
}
