    private string creatorBgColor = "#075E54";
    private string[] statusPalette = { "#075E54", "#1E40AF", "#7C3AED", "#BE185D", "#B45309", "#374151" };

    // Calling screen state
    private bool isCallActive = false;
    private string activeCallContact = "";
    private string activeCallStatus = "Memanggil...";
    private bool isVideoCall = false;
    private bool isSpeakerOn = false;
    private bool isVideoMuted = false;
    private bool isMicMuted = false;
    private System.Threading.Timer? callDurationTimer;
    private int callSeconds = 0;
    private bool isFrontCamera = true;

    // Forum Komunitas state (Beda dari chat grup)
    private string activeForumCategory = "Semua";
    private readonly string[] forumCategories = { "Semua", "📢 Pengumuman", "💡 Ide & Fitur", "🛠️ Q&A Teknis", "💬 Diskusi Komunitas" };
    private List<LocalForumThread> forumThreads = [];
    private LocalForumThread? selectedThread;
    private List<LocalForumComment> threadComments = [];
    private string newCommentText = "";
    private bool showNewThreadModal = false;
    private string newThreadCategory = "💡 Ide & Fitur";
    private string newThreadTitle = "";
    private string newThreadContent = "";
    private string newThreadTags = "";

    private int TotalUnreadCount => conversations.Sum(c => c.UnreadCount);

    private List<LocalConversation> filteredConversations =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? conversations
            : conversations.Where(c => c.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                       (c.LastMessage?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    protected override void OnInitialized()
    {
        LoadAllData();
        var savedUrl = Db.GetState("ServerUrl");
        serverUrl = !string.IsNullOrEmpty(savedUrl) ? savedUrl : "http://localhost:5000";
        var savedToken = Db.GetState("Token");
        if (!string.IsNullOrEmpty(savedToken)) token = savedToken;
        currentUserName = Db.GetState("CurrentUserName") ?? "Kang Fadhil (Gravicode Studios)";
        currentUserEmail = Db.GetState("CurrentUserEmail") ?? "fadhil@gravicode.com";
        isOnlineServer = ChatClient.State == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected;
    }

    private void LoadAllData()
    {
        conversations = Db.GetConversations().ToList();
        var allStatuses = Db.GetStatuses().ToList();
        myStatus = allStatuses.FirstOrDefault(s => s.IsMine);
        recentStatuses = allStatuses.Where(s => !s.IsMine).ToList();
        callLogs = Db.GetCalls().ToList();
        LoadForumData();
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
    }

    private void ToggleSearch()
    {
        isSearching = !isSearching;
        if (!isSearching) searchQuery = "";
    }

    private void ToggleMenu() => showMenu = !showMenu;

    private void OpenChat(int conversationId)
    {
        Db.MarkConversationAsRead(conversationId);
        Nav.NavigateTo($"/chat/{conversationId}");
    }

    // ── Status Story Viewer ────────────────────────────────────────────────────
    private void ViewStatusStory(LocalStatus st)
    {
        activeStory = st;
        currentStoryIndex = recentStatuses.IndexOf(st);
        Db.MarkStatusViewed(st.Id);
        st.IsViewed = true;
        storyProgress = 0;
        storyReplyText = "";

        storyTimer?.Dispose();
        storyTimer = new System.Threading.Timer(_ =>
        {
            storyProgress += 2;
            if (storyProgress >= 100)
            {
                InvokeAsync(NextStory);
            }
            else
            {
                InvokeAsync(StateHasChanged);
            }
        }, null, 100, 100);
    }

    private void HandleMyStatusClick()
    {
        if (myStatus != null) ViewStatusStory(myStatus);
        else OpenStatusCreator();
    }

    private void CloseStory()
    {
        storyTimer?.Dispose();
        storyTimer = null;
        activeStory = null;
        LoadAllData();
        StateHasChanged();
    }

    private void NextStory()
    {
        if (currentStoryIndex < recentStatuses.Count - 1)
        {
            currentStoryIndex++;
            ViewStatusStory(recentStatuses[currentStoryIndex]);
        }
        else
        {
            CloseStory();
        }
    }

    private void PrevStory()
    {
        if (currentStoryIndex > 0)
        {
            currentStoryIndex--;
            ViewStatusStory(recentStatuses[currentStoryIndex]);
        }
    }

    private void SendStoryReply()
    {
        if (string.IsNullOrWhiteSpace(storyReplyText) || activeStory == null) return;
        var conv = Db.CreateOrGetPrivateChat(activeStory.UserName);
        Db.AddLocalMessage(conv.Id, "me", "Saya", $"Membalas status: \"{activeStory.TextContent}\"\n\n{storyReplyText}", true);
        CloseStory();
        OpenChat(conv.Id);
    }

    // ── Status Creator ────────────────────────────────────────────────────────
    private void OpenStatusCreator()
    {
        showStatusCreator = true;
        newStatusText = "";
    }

    private void SaveNewStatus()
    {
        if (string.IsNullOrWhiteSpace(newStatusText)) return;
        Db.AddStatus("Status Saya", newStatusText.Trim(), creatorBgColor, isMine: true);
        showStatusCreator = false;
        LoadAllData();
        StateHasChanged();
    }

    // ── Simulated WhatsApp Call ───────────────────────────────────────────────
    private void LaunchSimulatedCall(string contactName, bool isVideo)
    {
        activeCallContact = contactName;
        isVideoCall = isVideo;
        activeCallStatus = "Memanggil...";
        isCallActive = true;
        callSeconds = 0;
        isSpeakerOn = false;
        isMicMuted = false;

        // Transition: Memanggil -> Berdering -> Connected Timer
        Task.Run(async () =>
        {
            await Task.Delay(1400);
            activeCallStatus = "Berdering...";
            await InvokeAsync(StateHasChanged);

            await Task.Delay(1800);
            activeCallStatus = "00:00";
            callDurationTimer = new System.Threading.Timer(_ =>
            {
                callSeconds++;
                int min = callSeconds / 60;
                int sec = callSeconds % 60;
                activeCallStatus = $"{min:00}:{sec:00}";
                InvokeAsync(StateHasChanged);
            }, null, 1000, 1000);

            await InvokeAsync(StateHasChanged);
        });
    }

    private void EndCall()
    {
        callDurationTimer?.Dispose();
        callDurationTimer = null;
        isCallActive = false;

        string dur = callSeconds > 0 ? $"{callSeconds / 60:00}:{callSeconds % 60:00}" : "00:00";
        Db.AddCall(activeCallContact, isVideoCall, isIncoming: false, isMissed: callSeconds == 0, duration: dur);
        LoadAllData();
        StateHasChanged();
    }

    // ── Direct Chat (Tanpa Simpan Nomor) ──────────────────────────────────────
    private void StartDirectChat()
    {
        if (string.IsNullOrWhiteSpace(directPhoneNumber)) return;

        string cleanPhone = directPhoneNumber.Trim().Replace("-", "").Replace(" ", "").Replace("+", "");
        if (cleanPhone.StartsWith("0")) cleanPhone = "62" + cleanPhone.Substring(1);

        string chatName = $"+{cleanPhone}";
        var conv = Db.CreateOrGetPrivateChat(chatName);

        if (!string.IsNullOrWhiteSpace(directInitialMessage))
        {
            Db.AddLocalMessage(conv.Id, "me", "Saya", directInitialMessage.Trim(), true);
        }

        showDirectChatModal = false;
        directPhoneNumber = "";
        directInitialMessage = "";

        OpenChat(conv.Id);
    }

    private async Task ConnectServer()
    {
        if (string.IsNullOrWhiteSpace(serverUrl))
            serverUrl = "http://localhost:5000";

        try
        {
            if (string.IsNullOrWhiteSpace(token))
            {
                var loginJson = System.Text.Json.JsonSerializer.Serialize(new { email = "fadhil@gravicode.com", password = "Password123!" });
