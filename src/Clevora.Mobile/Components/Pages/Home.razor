        Db.AddThreadComment(selectedThread.Id, currentUserName, newCommentText.Trim());
        threadComments = Db.GetThreadComments(selectedThread.Id).ToList();
        selectedThread = Db.GetForumThread(selectedThread.Id);
        newCommentText = "";
        LoadForumData();
    }

    private void SubmitNewThread()
    {
        if (string.IsNullOrWhiteSpace(newThreadTitle) || string.IsNullOrWhiteSpace(newThreadContent)) return;
        Db.AddForumThread(newThreadCategory, newThreadTitle.Trim(), currentUserName, newThreadContent.Trim(), newThreadTags.Trim());
        showNewThreadModal = false;
        newThreadTitle = "";
        newThreadContent = "";
        newThreadTags = "";
        LoadForumData();
    }

    private void ToggleFlipCamera()
    {
        isFrontCamera = !isFrontCamera;
    }

    private string GetCategoryClass(string category)
    {
        if (category.Contains("Pengumuman")) return "wa-cat-announcement";
        if (category.Contains("Ide")) return "wa-cat-idea";
        if (category.Contains("Q&A") || category.Contains("Tanya")) return "wa-cat-qa";
        return "wa-cat-general";
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "WA";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }

    private string GetAvatarBg(string name)
    {
        string[] colors = { "#00A884", "#128C7E", "#25D366", "#0D9488", "#0284C7", "#7C3AED", "#DB2777" };
        int hash = Math.Abs(name.GetHashCode());
        return colors[hash % colors.Length];
    }

    private string FormatTimestamp(DateTime? dt)
    {
        if (dt is null) return "";
        var local = dt.Value.ToLocalTime();
        if (local.Date == DateTime.Now.Date) return local.ToString("HH:mm");
        if (local.Date == DateTime.Now.Date.AddDays(-1)) return "Kemarin";
        return local.ToString("dd/MM/yy");
    }

