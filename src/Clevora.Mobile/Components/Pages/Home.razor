@page "/"
@using Clevora.Mobile.Services
@inject LocalDatabaseService LocalDb
@inject NavigationManager Nav

<div class="mobile-home p-3">
    <!-- Header -->
    <div class="hero-card p-4 mb-4 rounded-4 text-white"
         style="background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);">
        <div class="fs-3 fw-bold">🟢 Clevora</div>
        <div class="small opacity-75 mt-1">Platform Pesan WhatsApp Profesional</div>
        <div class="mt-3 d-flex gap-3">
            <div class="text-center">
                <div class="fs-5 fw-bold">@templateCount</div>
                <div class="small opacity-75">Template</div>
            </div>
            <div class="text-center">
                <div class="fs-5 fw-bold">@categoryCount</div>
                <div class="small opacity-75">Kategori</div>
            </div>
            <div class="text-center">
                <div class="fs-5 fw-bold">@pendingCount</div>
                <div class="small opacity-75">Pending Sync</div>
            </div>
        </div>
    </div>

    <!-- Quick actions -->
    <h6 class="fw-bold text-muted small text-uppercase mb-2">Aksi Cepat</h6>
    <div class="d-grid gap-2 mb-4">
        <button class="btn btn-success py-3 fw-bold shadow-sm" @onclick='() => Nav.NavigateTo("/composer")'>
            ✏️ Buka Composer WA
        </button>
        <button class="btn btn-outline-success py-2" @onclick='() => Nav.NavigateTo("/templates")'>
            📋 Kelola Template
        </button>
    </div>

    <!-- Favorite templates -->
    @if (favorites.Any())
    {
        <h6 class="fw-bold text-muted small text-uppercase mb-2">⭐ Template Favorit</h6>
        <div class="d-flex flex-column gap-2 mb-4">
            @foreach (var t in favorites)
            {
                <div class="card border-warning shadow-sm p-2" @onclick="() => GoToComposer(t.Id)"
                     style="cursor:pointer;">
                    <div class="fw-bold small">@t.Title</div>
                    <div class="text-muted small text-truncate">@t.Body</div>
                </div>
            }
        </div>
    }

    <!-- Credit -->
    <div class="text-center text-muted mt-4" style="font-size:0.75rem;">
        Dibuat oleh <strong>Gravicode Studios</strong><br />
        dipimpin oleh <em>Kang Fadhil</em>
    </div>
</div>

@code {
    private int templateCount;
    private int categoryCount;
    private int pendingCount;
    private List<LocalTemplate> favorites = [];

    protected override void OnInitialized()
    {
        templateCount = LocalDb.GetTemplates().Count;
        categoryCount = LocalDb.GetCategories().Count;
        pendingCount = LocalDb.GetPendingOutbox().Count;
        favorites = LocalDb.GetTemplates().Where(t => t.IsFavorite).Take(5).ToList();
    }

    private void GoToComposer(int id) => Nav.NavigateTo("/composer/" + id.ToString());
}
