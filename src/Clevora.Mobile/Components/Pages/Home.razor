    private async Task QuickLogin(string email, string password, string displayName)
    {
        authErrorMessage = "";
        try
        {
            var loginJson = System.Text.Json.JsonSerializer.Serialize(new { email, password });
            var loginContent = new StringContent(loginJson, System.Text.Encoding.UTF8, "application/json");
            var res = await Http.PostAsync($"{serverUrl.TrimEnd('/')}/api/v1/auth/login", loginContent);
            if (res.IsSuccessStatusCode)
            {
                var resStr = await res.Content.ReadAsStringAsync();
                using var doc = System.Text.Json.JsonDocument.Parse(resStr);
                if (doc.RootElement.TryGetProperty("token", out var tokProp))
                {
                    token = tokProp.GetString() ?? "";
                }
                if (doc.RootElement.TryGetProperty("displayName", out var nameProp) && !string.IsNullOrWhiteSpace(nameProp.GetString()))
                {
                    currentUserName = nameProp.GetString()!;
                }
                else
                {
                    currentUserName = displayName;
                }
                if (doc.RootElement.TryGetProperty("email", out var emailProp) && !string.IsNullOrWhiteSpace(emailProp.GetString()))
                {
                    currentUserEmail = emailProp.GetString()!;
                }
                else
                {
                    currentUserEmail = email;
                }
                Db.SetState("Token", token);
                Db.SetState("CurrentUserName", currentUserName);
                Db.SetState("CurrentUserEmail", currentUserEmail);

                ChatClient.Configure(serverUrl, token);
                await ChatClient.ConnectAsync();
                isOnlineServer = ChatClient.State == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected;
                showAuthModal = false;
            }
            else
            {
                // Jika login gagal (misal akun baru), coba daftarkan otomatis
                var regName = string.IsNullOrWhiteSpace(displayName) ? email.Split('@')[0] : displayName;
                var regJson = System.Text.Json.JsonSerializer.Serialize(new { email = email.Trim(), password, displayName = regName });
                var regContent = new StringContent(regJson, System.Text.Encoding.UTF8, "application/json");
                var regRes = await Http.PostAsync($"{serverUrl.TrimEnd('/')}/api/v1/auth/register", regContent);
                if (regRes.IsSuccessStatusCode)
                {
                    var resStr = await regRes.Content.ReadAsStringAsync();
                    using var doc = System.Text.Json.JsonDocument.Parse(resStr);
                    if (doc.RootElement.TryGetProperty("token", out var tokProp))
                    {
                        token = tokProp.GetString() ?? "";
                    }
                    currentUserName = regName;
                    currentUserEmail = email;
                    Db.SetState("Token", token);
                    Db.SetState("CurrentUserName", currentUserName);
                    Db.SetState("CurrentUserEmail", currentUserEmail);

                    ChatClient.Configure(serverUrl, token);
                    await ChatClient.ConnectAsync();
                    isOnlineServer = ChatClient.State == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected;
                    showAuthModal = false;
                }
                else
                {
                    authErrorMessage = "Login & Registrasi tidak berhasil. Pastikan backend server aktif.";
                }
            }
        }
        catch (Exception ex)
        {
            // Beralih ke profil lokal saat offline
            currentUserName = displayName;
            currentUserEmail = email;
            Db.SetState("CurrentUserName", currentUserName);
            Db.SetState("CurrentUserEmail", currentUserEmail);
            authErrorMessage = $"Mode Offline: {ex.Message}. Profil lokal '{displayName}' aktif.";
            isOnlineServer = false;
        }
        StateHasChanged();
    }

    private async Task PerformLoginAsync()
    {
        if (string.IsNullOrWhiteSpace(authEmail) || string.IsNullOrWhiteSpace(authPassword))
        {
            authErrorMessage = "Email dan password wajib diisi.";
            return;
        }

        await QuickLogin(authEmail.Trim(), authPassword, authEmail.Trim());
    }

    private async Task PerformRegisterAsync()
    {
        if (string.IsNullOrWhiteSpace(authEmail) || string.IsNullOrWhiteSpace(authPassword))
        {
            authErrorMessage = "Nama, email, dan password wajib diisi.";
            return;
        }

        authErrorMessage = "";
        try
        {
            var regName = string.IsNullOrWhiteSpace(authDisplayName) ? authEmail.Split('@')[0] : authDisplayName.Trim();
            var regJson = System.Text.Json.JsonSerializer.Serialize(new { email = authEmail.Trim(), password = authPassword, displayName = regName });
            var regContent = new StringContent(regJson, System.Text.Encoding.UTF8, "application/json");
            var res = await Http.PostAsync($"{serverUrl.TrimEnd('/')}/api/v1/auth/register", regContent);
            if (res.IsSuccessStatusCode)
            {
                var resStr = await res.Content.ReadAsStringAsync();
                using var doc = System.Text.Json.JsonDocument.Parse(resStr);
                if (doc.RootElement.TryGetProperty("token", out var tokProp))
                {
                    token = tokProp.GetString() ?? "";
                }
                currentUserName = regName;
                currentUserEmail = authEmail.Trim();
                Db.SetState("Token", token);
                Db.SetState("CurrentUserName", currentUserName);
                Db.SetState("CurrentUserEmail", currentUserEmail);

                ChatClient.Configure(serverUrl, token);
                await ChatClient.ConnectAsync();
                isOnlineServer = ChatClient.State == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected;
                showAuthModal = false;
            }
            else
            {
                authErrorMessage = "Registrasi gagal. Email mungkin sudah terdaftar atau password < 6 karakter.";
            }
        }
        catch (Exception ex)
        {
            authErrorMessage = $"Gagal terhubung ke server: {ex.Message}";
        }
        StateHasChanged();
    }

