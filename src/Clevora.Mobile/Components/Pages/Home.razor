@page "/"
@using Clevora.Mobile.Services
@implements IDisposable
@inject LocalDatabaseService Db
@inject ChatClientService ChatClient
@inject NavigationManager Nav
@inject HttpClient Http

<div class="wa-app-container">
    <!-- WhatsApp Top Header -->
    <header class="wa-header">
        <div class="wa-header-top">
            <h1 class="wa-logo">WhatsApp</h1>
            <div class="wa-header-actions">
                <button class="wa-icon-btn" title="Kamera" @onclick='() => OpenStatusCreator()'>
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                        <path d="M12 9c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3m7-4h-3.17L14.4 3.14C14.03 2.76 13.53 2.5 13 2.5h-2c-.53 0-1.03.26-1.4.64L8.17 5H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2m-7 13c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5"/>
                    </svg>
                </button>
                <button class="wa-icon-btn" title="Cari" @onclick="ToggleSearch">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                        <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14"/>
                    </svg>
                </button>
                <button class="wa-icon-btn" title="Menu lainnya" @onclick="ToggleMenu">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                        <path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2m0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2m0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2"/>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Optional Search Bar -->
        @if (isSearching)
        {
            <div class="wa-search-bar">
                <input type="text" class="wa-search-input" placeholder="Cari percakapan..." @bind="searchQuery" @bind:event="oninput" autofocus />
                <button class="wa-search-clear" @onclick="ToggleSearch">✕</button>
            </div>
        }

        <!-- WhatsApp Tabs -->
        <nav class="wa-tabs">
            <button class="wa-tab-item wa-tab-community @(activeTab == "community" ? "active" : "")" @onclick='() => SetTab("community")' title="Komunitas">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                    <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3m-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3m0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5m8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5"/>
                </svg>
            </button>
            <button class="wa-tab-item @(activeTab == "chats" ? "active" : "")" @onclick='() => SetTab("chats")'>
                CHAT
                @if (TotalUnreadCount > 0)
                {
                    <span class="wa-tab-badge">@TotalUnreadCount</span>
                }
            </button>
            <button class="wa-tab-item @(activeTab == "status" ? "active" : "")" @onclick='() => SetTab("status")'>
                STATUS
                @if (recentStatuses.Any(s => !s.IsViewed))
                {
                    <span class="wa-tab-dot"></span>
                }
            </button>
            <button class="wa-tab-item @(activeTab == "calls" ? "active" : "")" @onclick='() => SetTab("calls")'>
                PANGGILAN
            </button>
        </nav>
    </header>

    <!-- Context Menu Dropdown -->
    @if (showMenu)
    {
        <div class="wa-menu-backdrop" @onclick="ToggleMenu"></div>
        <div class="wa-menu-dropdown">
            <div class="wa-menu-item" @onclick='() => { ToggleMenu(); Nav.NavigateTo("/new-chat"); }'>Grup baru</div>
            <div class="wa-menu-item" @onclick='() => { ToggleMenu(); Nav.NavigateTo("/new-chat"); }'>Chat baru</div>
            <div class="wa-menu-item" @onclick='() => { ToggleMenu(); showAuthModal = true; }'>👤 Akun &amp; Otentikasi (Auth)</div>
            <div class="wa-menu-item" @onclick='() => { ToggleMenu(); showDirectChatModal = true; }'>
                ✨ Chat Nomor Baru (Tanpa Simpan)
            </div>
            <div class="wa-menu-item" @onclick='() => { ToggleMenu(); Nav.NavigateTo("/settings"); }'>⚙️ Setelan WhatsApp</div>
            <div class="wa-menu-item" @onclick='() => { ToggleMenu(); showSettingsModal = true; }'>📶 Server Sync &amp; IP</div>
            <div class="wa-menu-item wa-menu-credit" @onclick='() => { ToggleMenu(); showAboutModal = true; }'>Tentang Clevora</div>
        </div>
    }

    <!-- Main Content by Tab -->
    <main class="wa-main-content">
        @if (activeTab == "chats")
        {
            <!-- CHATS TAB -->
            <div class="wa-chat-list">
                @if (!isOnlineServer)
                {
                    <div style="background:#FEF3C7;border-left:4px solid #F59E0B;padding:8px 12px;display:flex;align-items:center;justify-content:space-between;font-size:0.8rem;color:#92400E;margin-bottom:4px;">
                        <span>📶 <strong>Mode Offline:</strong> Server tidak berjalan. SQLite lokal aktif &amp; chat tetap tersimpan.</span>
                        <button style="background:#F59E0B;color:white;border:none;border-radius:4px;padding:3px 8px;font-size:0.75rem;cursor:pointer;font-weight:600;" @onclick="ConnectServer">Coba Hubungkan</button>
                    </div>
                }

                <!-- Fitur Tambahan Clevora Banner: Direct Chat -->
                <div class="wa-exclusive-banner" @onclick="() => showDirectChatModal = true">
                    <span class="wa-banner-icon">✨</span>
                    <div style="flex:1;">
                        <div style="font-weight:700;font-size:0.88rem;color:#008069;">Fitur Clevora: Chat Tanpa Simpan Nomor</div>
                        <div style="font-size:0.75rem;color:#667781;">Kirim pesan langsung ke nomor WhatsApp apa saja secara instan.</div>
                    </div>
                    <span style="font-size:1.1rem;color:#008069;">→</span>
                </div>

                @if (filteredConversations.Count == 0)
                {
                    <div class="wa-empty-state">
                        <div class="wa-empty-icon">💬</div>
                        <h3>Tidak ada percakapan</h3>
                        <p>Ketuk tombol pesan di pojok kanan bawah untuk memulai percakapan baru.</p>
                    </div>
                }
                else
                {
                    @foreach (var c in filteredConversations)
                    {
                        <div class="wa-chat-row" @onclick="() => OpenChat(c.Id)">
                            <div class="wa-avatar-container">
                                <div class="wa-avatar" style="background: @GetAvatarBg(c.Name)">
                                    @GetInitials(c.Name)
                                </div>
                                @if (c.IsOnline)
                                {
                                    <span class="wa-online-indicator"></span>
                                }
                            </div>
                            <div class="wa-chat-details">
                                <div class="wa-chat-top-row">
                                    <span class="wa-contact-name">@c.Name</span>
                                    <span class="wa-timestamp @(c.UnreadCount > 0 ? "highlight" : "")">
                                        @FormatTimestamp(c.LastMessageAt)
                                    </span>
                                </div>
                                <div class="wa-chat-bottom-row">
                                    <span class="wa-message-snippet">
                                        <span class="wa-tick">✓✓</span>
                                        @c.LastMessage
                                    </span>
                                    @if (c.UnreadCount > 0)
                                    {
                                        <span class="wa-unread-badge">@c.UnreadCount</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- WhatsApp FAB: Start New Chat -->
            <button class="wa-fab" title="Mulai Chat Baru" @onclick='() => Nav.NavigateTo("/new-chat")'>
                <svg viewBox="0 0 24 24" width="24" height="24" fill="white">
                    <path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2m-2 12H6v-2h12zm0-3H6V9h12zm0-3H6V6h12z"/>
                </svg>
            </button>
        }
        else if (activeTab == "status")
        {
            <!-- STATUS TAB -->
            <div class="wa-status-list">
                <!-- My Status -->
                <div class="wa-my-status-row" @onclick="HandleMyStatusClick">
                    <div class="wa-my-status-avatar-box">
                        <div class="wa-avatar wa-avatar-my" style="background:@(myStatus?.ColorBg ?? "#00A884")">
                            @(myStatus != null ? "S" : "S")
                        </div>
                        <span class="wa-add-status-plus">+</span>
                    </div>
                    <div class="wa-status-details">
                        <div class="wa-status-name">Status saya</div>
                        <div class="wa-status-sub">
                            @(myStatus != null ? $"Hari ini • {FormatTimestamp(myStatus.CreatedAt)}" : "Ketuk untuk menambahkan pembaruan status")
                        </div>
                    </div>
                </div>

                @if (recentStatuses.Any(s => !s.IsViewed))
                {
                    <div class="wa-status-section-header">Pembaruan terkini</div>
                    @foreach (var st in recentStatuses.Where(s => !s.IsViewed))
                    {
                        <div class="wa-status-row" @onclick="() => ViewStatusStory(st)">
                            <div class="wa-status-ring">
                                <div class="wa-avatar" style="background: @st.ColorBg">
                                    @GetInitials(st.UserName)
                                </div>
                            </div>
                            <div class="wa-status-details">
                                <div class="wa-status-name">@st.UserName</div>
                                <div class="wa-status-sub">@FormatTimestamp(st.CreatedAt)</div>
                            </div>
                        </div>
                    }
                }

                @if (recentStatuses.Any(s => s.IsViewed))
                {
                    <div class="wa-status-section-header">Pembaruan yang telah dilihat</div>
                    @foreach (var st in recentStatuses.Where(s => s.IsViewed))
                    {
                        <div class="wa-status-row wa-status-viewed" @onclick="() => ViewStatusStory(st)">
                            <div class="wa-status-ring viewed">
                                <div class="wa-avatar" style="background: @st.ColorBg">
                                    @GetInitials(st.UserName)
                                </div>
                            </div>
                            <div class="wa-status-details">
                                <div class="wa-status-name">@st.UserName</div>
                                <div class="wa-status-sub">@FormatTimestamp(st.CreatedAt)</div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- WhatsApp Status FABs -->
            <div class="wa-status-fabs">
                <button class="wa-fab-mini" title="Tulis status teks" @onclick="OpenStatusCreator">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="#54656F">
                        <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.996.996 0 0 0-1.41 0l-1.83 1.83 3.75 3.75z"/>
                    </svg>
                </button>
                <button class="wa-fab" title="Ambil foto status" @onclick="OpenStatusCreator">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="white">
                        <path d="M12 9c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3m7-4h-3.17L14.4 3.14C14.03 2.76 13.53 2.5 13 2.5h-2c-.53 0-1.03.26-1.4.64L8.17 5H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2m-7 13c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5"/>
                    </svg>
                </button>
            </div>
        }
        else if (activeTab == "calls")
        {
            <!-- CALLS TAB -->
            <div class="wa-call-list">
                <div class="wa-call-link-row">
                    <div class="wa-call-link-avatar">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="white">
                            <path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1M8 13h8v-2H8zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5"/>
                        </svg>
                    </div>
                    <div class="wa-call-details">
                        <div class="wa-call-name">Buat tautan panggilan</div>
                        <div class="wa-call-sub">Bagikan tautan untuk panggilan Clevora Anda</div>
                    </div>
                </div>

                <div class="wa-status-section-header">Terbaru</div>

                @foreach (var call in callLogs)
                {
                    <div class="wa-call-row">
                        <div class="wa-avatar" style="background:@GetAvatarBg(call.ContactName)">
                            @GetInitials(call.ContactName)
                        </div>
                        <div class="wa-call-details">
                            <div class="wa-call-name">@call.ContactName</div>
                            <div class="wa-call-sub">
                                @if (call.IsMissed)
                                {
                                    <span class="wa-call-arrow missed">↙</span>
                                    <span style="color:#DC2626;">Tak terjawab • @FormatTimestamp(call.Timestamp)</span>
                                }
                                else if (call.IsIncoming)
                                {
                                    <span class="wa-call-arrow incoming">↙</span>
                                    <span>Masuk (@call.Duration) • @FormatTimestamp(call.Timestamp)</span>
                                }
                                else
                                {
                                    <span class="wa-call-arrow outgoing">↗</span>
                                    <span>Keluar (@call.Duration) • @FormatTimestamp(call.Timestamp)</span>
                                }
                            </div>
                        </div>
                        <button class="wa-call-action-btn" @onclick="() => LaunchSimulatedCall(call.ContactName, call.IsVideo)">
                            @if (call.IsVideo)
                            {
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="#008069">
                                    <path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11z"/>
                                </svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="#008069">
                                    <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 0 0-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99"/>
                                </svg>
                            }
                        </button>
                    </div>
                }
            </div>

            <!-- Calls FAB -->
            <button class="wa-fab" title="Panggilan baru" @onclick='() => LaunchSimulatedCall("Kang Fadhil (Gravicode)", false)'>
                <svg viewBox="0 0 24 24" width="24" height="24" fill="white">
                    <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 0 0-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99"/>
                </svg>
            </button>
        }
        else if (activeTab == "community")
        {
            <!-- FORUM KOMUNITAS (BEDA DARI CHAT GRUP) -->
            <div class="wa-forum-container">
                <!-- Forum Header Banner -->
                <div class="wa-forum-header-banner">
                    <div style="flex:1;">
                        <div class="wa-forum-badge">COMMUNITY FORUM</div>
                        <h2 class="wa-forum-title">Forum Komunitas Clevora</h2>
                        <p class="wa-forum-subtitle">Beda dari chat grup biasa: diskusi topik terstruktur, ide fitur, dan tanya jawab teknis dengan sistem voting.</p>
                    </div>
                    <button class="wa-forum-btn-new" @onclick="() => showNewThreadModal = true">
                        + Buat Topik
                    </button>
                </div>

                <!-- Forum Category Filter Pills -->
                <div class="wa-forum-categories">
                    @foreach (var cat in forumCategories)
                    {
                        <button class="wa-forum-pill @(activeForumCategory == cat ? "active" : "")" 
                                @onclick="() => FilterForumCategory(cat)">
                            @cat
                        </button>
                    }
                </div>

                <!-- Threads List -->
                <div class="wa-forum-thread-list">
                    @if (forumThreads.Count == 0)
                    {
                        <div class="wa-empty-state" style="padding:40px 20px;">
                            <div class="wa-empty-icon">💡</div>
                            <h3>Belum ada topik diskusi</h3>
                            <p>Jadilah yang pertama membuat topik baru di kategori ini!</p>
                            <button class="wa-btn-primary" style="margin-top:12px;" @onclick="() => showNewThreadModal = true">Tulis Topik Pertama</button>
                        </div>
                    }
                    else
                    {
                        @foreach (var t in forumThreads)
                        {
                            <div class="wa-forum-card" @onclick="() => OpenThreadDetail(t)">
                                <div class="wa-forum-card-top">
                                    <span class="wa-category-tag @GetCategoryClass(t.Category)">@t.Category</span>
                                    <span class="wa-forum-time">@FormatTimestamp(t.CreatedAt)</span>
                                </div>

                                <div class="wa-forum-author-row">
                                    <div class="wa-avatar wa-avatar-sm" style="background:@GetAvatarBg(t.AuthorName)">
                                        @GetInitials(t.AuthorName)
                                    </div>
                                    <div class="wa-forum-author-name">
                                        @t.AuthorName
                                        @if (t.AuthorName.Contains("Fadhil") || t.AuthorName.Contains("Gravicode"))
                                        {
                                            <span class="wa-author-badge" title="Lead Developer">★ DEV</span>
                                        }
                                    </div>
                                </div>

                                <h3 class="wa-forum-card-title">@t.Title</h3>
                                <p class="wa-forum-card-content">@t.Content</p>

                                @if (!string.IsNullOrWhiteSpace(t.Tags))
                                {
                                    <div class="wa-forum-tags">
                                        @foreach (var tag in t.Tags.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <span class="wa-forum-tag-chip">@tag</span>
                                        }
                                    </div>
                                }

                                <div class="wa-forum-card-footer">
                                    <button class="wa-forum-upvote-btn @(t.HasUpvoted ? "upvoted" : "")" 
                                            @onclick="() => ToggleThreadUpvote(t.Id)" 
                                            @onclick:stopPropagation>
                                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                                            <path d="M12 4l-8 8h5v8h6v-8h5z"/>
                                        </svg>
                                        <span>@t.Upvotes</span>
                                    </button>

                                    <div class="wa-forum-replies-badge">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" style="margin-right:4px;">
                                            <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/>
                                        </svg>
                                        <span>@t.CommentCount balasan</span>
                                    </div>

                                    <span class="wa-forum-read-more">Lihat Diskusi →</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </main>

    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <!-- WHATSAPP STATUS STORY VIEWER (FULLSCREEN OVERLAY) -->
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    @if (activeStory != null)
    {
        <div class="wa-story-overlay" style="background: @activeStory.ColorBg">
            <!-- Top Progress Bar -->
            <div class="wa-story-progress-container">
                <div class="wa-story-progress-bar" style="width: @(storyProgress)%;"></div>
            </div>

            <!-- Story Header -->
            <div class="wa-story-header">
                <button class="wa-story-close" @onclick="CloseStory">✕</button>
                <div class="wa-avatar" style="width:36px;height:36px;font-size:0.9rem;background:rgba(255,255,255,0.25)">
                    @GetInitials(activeStory.UserName)
                </div>
                <div class="wa-story-user-meta">
                    <div class="wa-story-user-name">@activeStory.UserName</div>
                    <div class="wa-story-time">@FormatTimestamp(activeStory.CreatedAt)</div>
                </div>
            </div>

            <!-- Story Body with Tapping Zones -->
            <div class="wa-story-content">
                <div class="wa-story-tap-left" @onclick="PrevStory" title="Sebelumnya"></div>
                <div class="wa-story-text">
                    @activeStory.TextContent
                </div>
                <div class="wa-story-tap-right" @onclick="NextStory" title="Selanjutnya"></div>
            </div>

            <!-- Bottom Reply Bar -->
            <div class="wa-story-footer">
                <input class="wa-story-reply-input" placeholder="Balas status..." @bind="storyReplyText" />
                <button class="wa-story-send-btn" @onclick="SendStoryReply">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="white">
                        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                    </svg>
                </button>
            </div>
        </div>
    }

    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <!-- WHATSAPP STATUS CREATOR -->
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    @if (showStatusCreator)
    {
        <div class="wa-status-creator-screen" style="background: @creatorBgColor">
            <div class="wa-status-creator-header">
                <button class="wa-story-close" @onclick="() => showStatusCreator = false">✕</button>
                <div class="wa-color-palette">
                    @foreach (var c in statusPalette)
                    {
                        <span class="wa-color-dot @(creatorBgColor == c ? "selected" : "")" 
                              style="background:@c" 
                              @onclick="() => creatorBgColor = c"></span>
                    }
                </div>
            </div>

            <textarea class="wa-status-creator-input" 
                      placeholder="Ketik status teks Anda..." 
                      @bind="newStatusText" 
                      autofocus></textarea>

            <button class="wa-fab" style="position:absolute;bottom:24px;right:24px;" @onclick="SaveNewStatus">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="white">
                    <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                </svg>
            </button>
        </div>
    }

    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <!-- INTERACTIVE WHATSAPP CALL SCREEN (VIDEO & VOICE) -->
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    @if (isCallActive)
    {
        <div class="wa-call-screen @(isVideoCall ? "video-mode" : "audio-mode")">
            <div class="wa-call-screen-header">
                <div class="wa-call-encryption">🔒 Terenkripsi end-to-end</div>
                <div class="wa-call-contact-name">@activeCallContact</div>
                <div class="wa-call-status-label">
                    @(isVideoCall ? $"Panggilan Video • {activeCallStatus}" : $"Panggilan Suara • {activeCallStatus}")
                </div>
            </div>

            @if (isVideoCall)
            {
                <!-- Remote Video Stream Simulation -->
                <div class="wa-video-call-remote">
                    <div class="wa-video-feed-simulation">
                        @if (isVideoMuted)
                        {
                            <div class="wa-video-camera-off">
                                <div class="wa-avatar" style="width:110px;height:110px;font-size:2.8rem;background:@GetAvatarBg(activeCallContact)">
                                    @GetInitials(activeCallContact)
                                </div>
                                <div style="margin-top:12px;font-size:0.85rem;color:#8696A0;">Kamera dinonaktifkan</div>
                            </div>
                        }
                        else
                        {
                            <div class="wa-simulated-webcam">
                                <div class="wa-avatar wa-avatar-video-pulse" style="width:120px;height:120px;font-size:3rem;background:@GetAvatarBg(activeCallContact)">
                                    @GetInitials(activeCallContact)
                                </div>
                                <div class="wa-video-live-badge">● LIVE HD (60 FPS)</div>
                                <div class="wa-video-partner-name">@activeCallContact</div>
                            </div>
                        }
                    </div>

                    <!-- Local Camera Picture-in-Picture (PiP) Window -->
                    <div class="wa-pip-window">
                        <div class="wa-pip-camera-preview">
                            <span class="wa-pip-label">@(isFrontCamera ? "Kamera Depan" : "Kamera Belakang")</span>
                            <div class="wa-pip-avatar">Anda</div>
                        </div>
                        <button class="wa-pip-flip-btn" @onclick="ToggleFlipCamera" title="Putar Kamera">
                            🔄
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="wa-call-avatar-center">
                    <div class="wa-avatar" style="width:120px;height:120px;font-size:2.8rem;background:@GetAvatarBg(activeCallContact)">
                        @GetInitials(activeCallContact)
                    </div>
                </div>
            }

            <div class="wa-call-controls">
                @if (isVideoCall)
                {
                    <button class="wa-call-round-btn" @onclick="ToggleFlipCamera" title="Putar Kamera">
                        🔄
                    </button>
                }
                <button class="wa-call-round-btn @(isSpeakerOn ? "active" : "")" @onclick="() => isSpeakerOn = !isSpeakerOn" title="Speaker">
                    🔊
                </button>
                <button class="wa-call-round-btn @(isVideoMuted ? "active" : "")" @onclick="() => isVideoMuted = !isVideoMuted" title="Kamera">
                    📹
                </button>
                <button class="wa-call-round-btn @(isMicMuted ? "active" : "")" @onclick="() => isMicMuted = !isMicMuted" title="Mute Mic">
                    🎙️
                </button>
                <button class="wa-call-end-btn" @onclick="EndCall" title="Akhiri Panggilan">
                    <svg viewBox="0 0 24 24" width="30" height="30" fill="white">
                        <path d="M12 9c-1.6 0-3.15.25-4.6.72v3.1c0 .39-.23.74-.56.9-.98.49-1.87 1.12-2.66 1.85-.18.18-.43.28-.7.28-.28 0-.53-.11-.71-.29L.29 13.08a.996.996 0 0 1 0-1.41C3.42 8.73 7.48 7 12 7c4.52 0 8.58 1.73 11.71 4.67.39.39.39 1.02 0 1.41l-2.48 2.48c-.18.18-.43.29-.71.29-.27 0-.52-.11-.7-.28-.79-.74-1.69-1.36-2.67-1.85-.33-.16-.56-.5-.56-.9v-3.1C15.15 9.25 13.6 9 12 9z"/>
                    </svg>
                </button>
            </div>
        </div>
    }

    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <!-- FORUM: THREAD DETAIL & COMMENTS MODAL (BEDA DARI GRUP) -->
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    @if (selectedThread != null)
    {
        <div class="wa-modal-backdrop" @onclick="CloseThreadDetail">
            <div class="wa-forum-modal-card" @onclick:stopPropagation>
                <!-- Detail Header -->
                <div class="wa-forum-modal-header">
                    <button class="wa-back-btn" @onclick="CloseThreadDetail" title="Tutup">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="white">
                            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                        </svg>
                    </button>
                    <div style="flex:1;overflow:hidden;">
                        <span class="wa-category-tag @GetCategoryClass(selectedThread.Category)">@selectedThread.Category</span>
                        <h4 style="margin:2px 0 0;font-size:0.95rem;color:white;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@selectedThread.Title</h4>
                    </div>
                </div>

                <!-- Detail Body (Thread + Comments) -->
                <div class="wa-forum-modal-body">
                    <!-- Thread Original Post -->
                    <div class="wa-forum-thread-post">
                        <div class="wa-forum-author-row">
                            <div class="wa-avatar wa-avatar-sm" style="background:@GetAvatarBg(selectedThread.AuthorName)">
                                @GetInitials(selectedThread.AuthorName)
                            </div>
                            <div>
                                <div class="wa-forum-author-name">
                                    @selectedThread.AuthorName
                                    @if (selectedThread.AuthorName.Contains("Fadhil") || selectedThread.AuthorName.Contains("Gravicode"))
                                    {
                                        <span class="wa-author-badge">★ DEV</span>
                                    }
                                </div>
                                <div class="wa-forum-time">Diposting @FormatTimestamp(selectedThread.CreatedAt)</div>
                            </div>
                        </div>

                        <h2 class="wa-thread-detail-title">@selectedThread.Title</h2>
                        <div class="wa-thread-detail-content">@selectedThread.Content</div>

                        @if (!string.IsNullOrWhiteSpace(selectedThread.Tags))
                        {
                            <div class="wa-forum-tags" style="margin-top:10px;">
                                @foreach (var tag in selectedThread.Tags.Split(' ', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="wa-forum-tag-chip">@tag</span>
                                }
                            </div>
                        }

                        <div style="margin-top:12px;display:flex;align-items:center;gap:12px;">
                            <button class="wa-forum-upvote-btn @(selectedThread.HasUpvoted ? "upvoted" : "")" 
                                    @onclick="() => ToggleThreadUpvote(selectedThread.Id)">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                                    <path d="M12 4l-8 8h5v8h6v-8h5z"/>
                                </svg>
                                <span>▲ @selectedThread.Upvotes Dukungan Upvote</span>
                            </button>
                        </div>
                    </div>

                    <!-- Threaded Comments Section -->
                    <div class="wa-forum-comments-section">
                        <div class="wa-forum-section-title">
                            💬 Diskusi &amp; Balasan (@threadComments.Count)
                        </div>

                        @if (threadComments.Count == 0)
                        {
                            <div style="text-align:center;color:#8696A0;padding:20px;font-size:0.85rem;">
                                Belum ada balasan. Jadilah yang pertama memberikan solusi atau tanggapan!
                            </div>
                        }
                        else
                        {
                            @foreach (var c in threadComments)
                            {
                                <div class="wa-forum-comment-card">
                                    <div class="wa-forum-comment-header">
                                        <div class="wa-avatar" style="width:28px;height:28px;font-size:0.75rem;background:@GetAvatarBg(c.AuthorName)">
                                            @GetInitials(c.AuthorName)
                                        </div>
                                        <div style="flex:1;">
                                            <span style="font-weight:700;font-size:0.85rem;color:#111B21;">@c.AuthorName</span>
                                            <span style="font-size:0.72rem;color:#8696A0;margin-left:6px;">@FormatTimestamp(c.CreatedAt)</span>
                                        </div>
                                    </div>
                                    <div class="wa-forum-comment-body">
                                        @c.Content
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- Reply Input Bar -->
                <div class="wa-forum-reply-bar">
                    <input class="wa-forum-reply-input" 
                           placeholder="Tulis balasan atau saran..." 
                           @bind="newCommentText" 
                           @bind:event="oninput" 
                           @onkeyup='(e) => { if (e.Key == "Enter") SubmitComment(); }' />
                    <button class="wa-forum-send-btn" @onclick="SubmitComment" disabled="@string.IsNullOrWhiteSpace(newCommentText)">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="white">
                            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <!-- FORUM: BUAT TOPIK BARU MODAL -->
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    @if (showNewThreadModal)
    {
        <div class="wa-modal-backdrop" @onclick="() => showNewThreadModal = false">
            <div class="wa-modal-card" @onclick:stopPropagation style="max-width:440px;">
                <div class="wa-modal-header">
                    <h3>📝 Buat Topik Forum Baru</h3>
                    <button class="wa-modal-close" @onclick="() => showNewThreadModal = false">✕</button>
                </div>
                <div class="wa-modal-body">
                    <label class="wa-label">Kategori Diskusi</label>
                    <select class="wa-input" @bind="newThreadCategory">
                        <option value="📢 Pengumuman">📢 Pengumuman Resmi</option>
                        <option value="💡 Ide &amp; Fitur">💡 Ide &amp; Usulan Fitur</option>
                        <option value="🛠️ Q&amp;A Teknis">🛠️ Tanya Jawab / Q&amp;A Teknis</option>
                        <option value="💬 Diskusi Komunitas">💬 Diskusi Komunitas &amp; Santai</option>
                    </select>

                    <label class="wa-label" style="margin-top:10px;">Judul Topik</label>
                    <input class="wa-input" @bind="newThreadTitle" placeholder="Contoh: Arsitektur .NET 10 MAUI &amp; SQLite" />

                    <label class="wa-label" style="margin-top:10px;">Isi / Konten Diskusi</label>
                    <textarea class="wa-input" style="height:90px;resize:none;" @bind="newThreadContent" placeholder="Jelaskan secara mendalam tentang topik yang ingin dibahas..."></textarea>

                    <label class="wa-label" style="margin-top:10px;">Tagar (Opsional)</label>
                    <input class="wa-input" @bind="newThreadTags" placeholder="Contoh: #dotnet10 #maui #sqlite #clevora" />

                    <button class="wa-btn-primary" style="margin-top:16px;width:100%;" @onclick="SubmitNewThread" disabled="@(string.IsNullOrWhiteSpace(newThreadTitle) || string.IsNullOrWhiteSpace(newThreadContent))">
                        🚀 Publikasikan Topik ke Forum
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <!-- FITUR TAMBAHAN: MODAL CHAT TANPA SIMPAN NOMOR (DIRECT CHAT) -->
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    @if (showDirectChatModal)
    {
        <div class="wa-modal-backdrop" @onclick="() => showDirectChatModal = false">
            <div class="wa-modal-card" @onclick:stopPropagation>
                <div class="wa-modal-header">
                    <h3>✨ Kirim Chat Tanpa Simpan Kontak</h3>
                    <button class="wa-modal-close" @onclick="() => showDirectChatModal = false">✕</button>
                </div>
                <div class="wa-modal-body">
                    <p style="font-size:0.84rem;color:#667781;margin-bottom:12px;">
                        Kirim pesan langsung ke nomor WhatsApp manapun tanpa perlu menyimpannya ke buku telepon ponsel Anda.
                    </p>
                    <label class="wa-label">Nomor WhatsApp Tujuan</label>
                    <input class="wa-input" @bind="directPhoneNumber" placeholder="Contoh: 08123456789 atau 62812..." />

                    <label class="wa-label" style="margin-top:10px;">Pesan Pembuka (Opsional)</label>
                    <textarea class="wa-input" style="height:70px;resize:none;" @bind="directInitialMessage" placeholder="Halo, saya ingin menanyakan..."></textarea>

                    <button class="wa-btn-primary" style="margin-top:14px;width:100%;" @onclick="StartDirectChat">
                        Mulai Chat Sekarang 🚀
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Settings Modal -->
    @if (showSettingsModal)
    {
        <div class="wa-modal-backdrop" @onclick="() => showSettingsModal = false">
            <div class="wa-modal-card" @onclick:stopPropagation>
                <div class="wa-modal-header">
                    <h3>Setelan Server &amp; Sinkronisasi</h3>
                    <button class="wa-modal-close" @onclick="() => showSettingsModal = false">✕</button>
                </div>
                <div class="wa-modal-body">
                    <p style="font-size:0.85rem;color:#667781;margin-bottom:12px;">
                        Clevora bekerja offline-first dengan SQLite lokal. Hubungkan ke server cloud untuk mengaktifkan real-time SignalR chat.
                    </p>
                    <label class="wa-label">URL Backend Server</label>
                    <input class="wa-input" @bind="serverUrl" placeholder="http://10.0.2.2:5000 atau https://clevora.gravicode.com" />
                    
                    <div style="display:flex;gap:6px;margin-top:6px;flex-wrap:wrap;">
                        <button type="button" style="background:#F1F5F9;border:1px solid #CBD5E1;border-radius:6px;padding:4px 8px;font-size:0.75rem;cursor:pointer;color:#334155;"
                                @onclick='() => serverUrl = "http://localhost:5000"'>
                            💻 PC / Desktop (localhost)
                        </button>
                        <button type="button" style="background:#F1F5F9;border:1px solid #CBD5E1;border-radius:6px;padding:4px 8px;font-size:0.75rem;cursor:pointer;color:#334155;"
                                @onclick='() => serverUrl = "http://10.0.2.2:5000"'>
                            📱 Emulator Android (10.0.2.2)
                        </button>
                    </div>

                    <label class="wa-label" style="margin-top:10px;">Token JWT / Auth</label>
                    <input class="wa-input" type="password" @bind="token" placeholder="Bearer eyJhbGciOi..." />

                    <div class="wa-connection-badge @(isOnlineServer ? "connected" : "disconnected")">
                        @(isOnlineServer ? "● Terhubung ke SignalR Cloud Server" : "○ Mode Offline (Database SQLite Lokal Aktif)")
                    </div>

                    <button class="wa-btn-primary" style="margin-top:14px;width:100%;" @onclick="ConnectServer">
                        Simpan &amp; Hubungkan
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Auth & Account Switcher Modal -->
    @if (showAuthModal)
    {
        <div class="wa-modal-backdrop" @onclick="() => showAuthModal = false">
            <div class="wa-modal-card" @onclick:stopPropagation style="max-height:85vh;overflow-y:auto;">
                <div class="wa-modal-header">
                    <h3>👤 Akun &amp; Otentikasi Clevora</h3>
                    <button class="wa-modal-close" @onclick="() => showAuthModal = false">✕</button>
                </div>
                <div class="wa-modal-body">
                    <div style="background:#F0FDF4;border:1px solid #86EFAC;border-radius:10px;padding:10px;margin-bottom:12px;">
                        <div style="font-size:0.75rem;color:#16A34A;font-weight:700;">PROFIL AKTIF SAAT INI</div>
                        <div style="font-size:0.95rem;font-weight:700;color:#111B21;margin-top:2px;">@currentUserName</div>
                        <div style="font-size:0.8rem;color:#667781;">@currentUserEmail</div>
                        <div class="wa-connection-badge @(isOnlineServer ? "connected" : "disconnected")" style="margin-top:6px;">
                            @(isOnlineServer ? "● Terhubung ke Server (JWT Aktif)" : "○ Mode Offline (Lokal SQLite Aktif)")
                        </div>
                    </div>

                    <div style="font-weight:700;font-size:0.85rem;color:#111B21;margin-bottom:6px;">🚀 Masuk Cepat (Demo Chat Gravicode):</div>
                    <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:14px;">
                        <button type="button" class="wa-btn-primary" style="background:#008069;text-align:left;padding:8px 12px;font-size:0.82rem;"
                                @onclick='() => QuickLogin("fadhil@gravicode.com", "Password123!", "Kang Fadhil (Gravicode Studios)")'>
                            🟢 Masuk sebagai Kang Fadhil (fadhil@gravicode.com)
                        </button>
                        <button type="button" class="wa-btn-primary" style="background:#0284C7;text-align:left;padding:8px 12px;font-size:0.82rem;"
                                @onclick='() => QuickLogin("user@clevora.com", "Password123!", "Pengguna Demo")'>
                            🔵 Masuk sebagai Pengguna Demo (user@clevora.com)
                        </button>
                        <button type="button" class="wa-btn-primary" style="background:#7C3AED;text-align:left;padding:8px 12px;font-size:0.82rem;"
                                @onclick='() => QuickLogin("budisantoso@gravicode.com", "Password123!", "Budi Santoso")'>
                            🟣 Masuk sebagai Budi Santoso (budisantoso@gravicode.com)
                        </button>
                        <button type="button" class="wa-btn-primary" style="background:#EA580C;text-align:left;padding:8px 12px;font-size:0.82rem;"
                                @onclick='() => QuickLogin("iruzzz@gravicode.com", "Password123!", "Iruzzz67 (DevOps)")'>
                            🟠 Masuk sebagai Iruzzz67 (iruzzz@gravicode.com)
                        </button>
                    </div>

                    <div style="display:flex;gap:8px;border-bottom:1px solid #E2E8F0;margin-bottom:10px;">
                        <button type="button" style="border:none;background:none;font-weight:700;font-size:0.85rem;padding:6px 0;color:@(authTab == "login" ? "#008069" : "#64748B");border-bottom:@(authTab == "login" ? "2px solid #008069" : "none");cursor:pointer;"
                                @onclick='() => authTab = "login"'>
                            Masuk / Login
                        </button>
                        <button type="button" style="border:none;background:none;font-weight:700;font-size:0.85rem;padding:6px 0;color:@(authTab == "register" ? "#008069" : "#64748B");border-bottom:@(authTab == "register" ? "2px solid #008069" : "none");cursor:pointer;"
                                @onclick='() => authTab = "register"'>
                            Daftar Akun Baru
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(authErrorMessage))
                    {
                        <div style="background:#FEE2E2;border:1px solid #FCA5A5;color:#B91C1C;padding:8px;border-radius:6px;font-size:0.8rem;margin-bottom:10px;">
                            @authErrorMessage
                        </div>
                    }

                    @if (authTab == "login")
                    {
                        <label class="wa-label">Email / Nama Pengguna / ID Akun</label>
                        <input class="wa-input" @bind="authEmail" placeholder="nama / email / ID akun" />

                        <label class="wa-label" style="margin-top:8px;">Password</label>
                        <input class="wa-input" type="password" @bind="authPassword" placeholder="Password akun (default: Password123!)" />

                        <button class="wa-btn-primary" style="margin-top:12px;width:100%;" @onclick="PerformLoginAsync">
                            Masuk ke Akun
                        </button>
                    }
                    else
                    {
                        <label class="wa-label">Nama Lengkap / Tampilan</label>
                        <input class="wa-input" @bind="authDisplayName" placeholder="Contoh: Siti Rahma / Budi Santoso" />

                        <label class="wa-label" style="margin-top:8px;">Email / Nama Pengguna / ID Akun</label>
                        <input class="wa-input" @bind="authEmail" placeholder="nama / email / ID akun" />

                        <label class="wa-label" style="margin-top:8px;">Password</label>
                        <input class="wa-input" type="password" @bind="authPassword" placeholder="Minimal 6 karakter" />

                        <button class="wa-btn-primary" style="margin-top:12px;width:100%;background:#0284C7;" @onclick="PerformRegisterAsync">
                            Daftar &amp; Masuk Otomatis
                        </button>
                    }

                    <hr style="margin:14px 0 10px;border-top:1px solid #E2E8F0;" />
                    <button type="button" class="wa-btn-primary" style="background:#64748B;width:100%;font-size:0.8rem;padding:8px;"
                            @onclick="SwitchToOfflineMode">
                        📶 Beralih ke Mode Offline Mandiri (Tanpa Server)
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- About Modal -->
    @if (showAboutModal)
    {
        <div class="wa-modal-backdrop" @onclick="() => showAboutModal = false">
            <div class="wa-modal-card" @onclick:stopPropagation>
                <div class="wa-modal-header">
                    <h3>Tentang Clevora WhatsApp</h3>
                    <button class="wa-modal-close" @onclick="() => showAboutModal = false">✕</button>
                </div>
                <div class="wa-modal-body" style="text-align:center;">
                    <div style="font-size:3rem;margin-bottom:8px;">🟢</div>
                    <h2 style="font-size:1.3rem;font-weight:700;color:#008069;">Clevora Mobile v1.0.0</h2>
                    <p style="font-size:0.9rem;color:#111B21;margin:8px 0;font-weight:600;">
                        WhatsApp Full Experience + AI Copilot Platform
                    </p>
                    <p style="font-size:0.82rem;color:#667781;line-height:1.5;">
                        Dibuat oleh <strong>Gravicode Studios</strong> dipimpin oleh <em>Kang Fadhil</em>.<br/>
                        Teknologi: .NET 10 LTS, MAUI Blazor Hybrid, SQLite Offline-First, SignalR Core.
                    </p>
                    <div style="margin-top:16px;padding:10px;background:#F0F2F5;border-radius:8px;font-size:0.78rem;color:#54656F;">
                        © 2026 Gravicode Studios. Hak Cipta Dilindungi.
                    </div>
                </div>
            </div>
        </div>
    }
</div>

