                var res = await Http.PostAsync($"{serverUrl.TrimEnd('/')}/api/v1/auth/login", loginContent);
                if (res.IsSuccessStatusCode)
                {
                    var resStr = await res.Content.ReadAsStringAsync();
                    using var doc = System.Text.Json.JsonDocument.Parse(resStr);
                    if (doc.RootElement.TryGetProperty("token", out var tokProp))
                    {
                        token = tokProp.GetString() ?? "";
                    }
                }
            }

            Db.SetState("ServerUrl", serverUrl);
            Db.SetState("Token", token);

            ChatClient.Configure(serverUrl, token);
            await ChatClient.ConnectAsync();
            isOnlineServer = ChatClient.State == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected;
        }
        catch { isOnlineServer = false; }

        showSettingsModal = false;
        StateHasChanged();
