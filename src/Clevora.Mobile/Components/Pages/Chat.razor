@code {
    [Parameter] public int ConversationId { get; set; }

    private List<LocalMessage> messages = [];
    private string inputMessage = "";
    private string conversationTitle = "WhatsApp";
    private string initials = "WA";
    private string avatarBg = "#008069";
    private bool isGroup = false;
    private bool isOnline = true;
    private string lastSeenTime = "10.45";

    private bool isPartnerTyping = false;
    private bool showChatMenu = false;
    private bool showAttachmentMenu = false;

    // Calling state
    private bool isCallActive = false;
    private bool isVideoCall = false;
    private string activeCallStatus = "Memanggil...";
    private bool isSpeakerOn = false;
    private bool isVideoMuted = false;
    private bool isMicMuted = false;
    private bool isFrontCamera = true;
    private System.Threading.Timer? callDurationTimer;
    private int callSeconds = 0;

    protected override async Task OnInitializedAsync()
    {
        var conv = Db.GetConversationById(ConversationId);
        if (conv is not null)
        {
            conversationTitle = conv.Name;
            isGroup = conv.IsGroup;
            isOnline = conv.IsOnline;
            initials = GetInitials(conv.Name);
            avatarBg = GetAvatarBg(conv.Name);
        }

        LoadMessages();
        Db.MarkConversationAsRead(ConversationId);

        // SignalR event hooks
        ChatClient.OnMessageReceived += OnSignalRMessageReceived;
        ChatClient.OnUserTyping += OnSignalRTyping;
        ChatClient.OnUserStoppedTyping += OnSignalRStoppedTyping;

        await ChatClient.JoinConversationAsync(ConversationId);
    }

    private void LoadMessages()
    {
        messages = Db.GetMessages(ConversationId).ToList();
    }

    private void GoBack()
    {
        Nav.NavigateTo("/");
    }

    private void ToggleChatMenu() => showChatMenu = !showChatMenu;
    private void ToggleAttachmentMenu() => showAttachmentMenu = !showAttachmentMenu;
    private void ToggleProfileInfo() => AlertAction($"Profil: {conversationTitle}");

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            SendMessage();
        }
    }

    private void InsertEmoji(string emoji)
    {
        inputMessage += emoji;
    }

    private void InsertAttachment(string filename)
    {
        inputMessage += $" [📎 {filename}] ";
        showAttachmentMenu = false;
    }

    private async void SendMessage()
    {
        if (string.IsNullOrWhiteSpace(inputMessage)) return;

        var text = inputMessage.Trim();
        inputMessage = "";

        // 1. Save locally to SQLite
        var msg = Db.AddLocalMessage(ConversationId, "me", "Saya", text, true, MessageType.Text);
        messages.Add(msg);
        StateHasChanged();

        // 2. Push via SignalR if online
        try
        {
            await ChatClient.SendMessageAsync(ConversationId, text);
        }
        catch { }

        // 3. Simulated response for realistic WhatsApp demo
        TriggerSimulatedResponse(text);
    }

    private async void TriggerSimulatedResponse(string userText)
    {
        // Give realistic reply after 1.5 seconds if talking to Kang Fadhil or Dev team
        await Task.Delay(800);
        isPartnerTyping = true;
        StateHasChanged();

        await Task.Delay(1200);
        isPartnerTyping = false;

        string replyText;
        string sender = conversationTitle;
        string senderId = "partner";

        if (conversationTitle.Contains("Kang Fadhil"))
        {
            replyText = userText.Length < 10
                ? "Siap, fitur Clevora WhatsApp ini berjalan lancar di Android MAUI!"
                : $"Terima kasih! Terkait \"{userText}\", arsitektur .NET 10 LTS dan SQLite offline cache sudah memastikannya tetap responsif tanpa internet.";
            sender = "Kang Fadhil";
            senderId = "kf";
        }
        else if (conversationTitle.Contains("Tim"))
        {
            replyText = "Mantap! Tim terus memantau performa Kestrel, Nginx, dan sinkronisasi SQLite WAL 👍";
            sender = "Iruzzz67";
            senderId = "iruzzz";
        }
        else
        {
            replyText = "Pesan diterima dengan baik via Clevora WhatsApp!";
        }

        var replyMsg = Db.AddLocalMessage(ConversationId, senderId, sender, replyText, false, MessageType.Text);
        messages.Add(replyMsg);
        StateHasChanged();
    }

    private void ClearChat()
    {
        // Simple UI refresh
        messages.Clear();
        showChatMenu = false;
        StateHasChanged();
    }

    private void AlertAction(string msg)
    {
        showChatMenu = false;
    }

    private void OnSignalRMessageReceived(MessageDto dto)
    {
        if (dto.ConversationId == ConversationId)
        {
            Db.SaveMessage(dto, "me");
            InvokeAsync(() =>
            {
                LoadMessages();
                StateHasChanged();
            });
        }
    }

    private void OnSignalRTyping(string userId, int convId)
    {
        if (convId == ConversationId)
        {
            isPartnerTyping = true;
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnSignalRStoppedTyping(string userId, int convId)
    {
        if (convId == ConversationId)
        {
            isPartnerTyping = false;
            InvokeAsync(StateHasChanged);
        }
    }

    private string FormatMessage(string body)
    {
        if (string.IsNullOrEmpty(body)) return string.Empty;
        // Basic WhatsApp Markdown
        var formatted = System.Net.WebUtility.HtmlEncode(body);
        formatted = System.Text.RegularExpressions.Regex.Replace(formatted, @"\*(.*?)\*", "<strong>$1</strong>");
        formatted = System.Text.RegularExpressions.Regex.Replace(formatted, @"_(.*?)_", "<em>$1</em>");
        formatted = System.Text.RegularExpressions.Regex.Replace(formatted, @"~(.*?)~", "<del>$1</del>");
        return formatted;
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "WA";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }

    private string GetAvatarBg(string name)
    {
        string[] colors = { "#00A884", "#128C7E", "#25D366", "#0D9488", "#0284C7", "#7C3AED", "#DB2777" };
        int hash = Math.Abs(name.GetHashCode());
        return colors[hash % colors.Length];
    }

    private void StartCall(bool isVideo)
    {
        isVideoCall = isVideo;
        activeCallStatus = "Memanggil...";
        isCallActive = true;
        callSeconds = 0;
        isSpeakerOn = false;
        isMicMuted = false;
        isVideoMuted = false;

        Task.Run(async () =>
        {
            await Task.Delay(1400);
            activeCallStatus = "Berdering...";
            await InvokeAsync(StateHasChanged);

            await Task.Delay(1800);
            activeCallStatus = "00:00";
            callDurationTimer = new System.Threading.Timer(_ =>
            {
                callSeconds++;
                int min = callSeconds / 60;
                int sec = callSeconds % 60;
                activeCallStatus = $"{min:00}:{sec:00}";
                InvokeAsync(StateHasChanged);
            }, null, 1000, 1000);

            await InvokeAsync(StateHasChanged);
        });
    }

    private void EndCall()
    {
        callDurationTimer?.Dispose();
        callDurationTimer = null;
        isCallActive = false;

        string dur = callSeconds > 0 ? $"{callSeconds / 60:00}:{callSeconds % 60:00}" : "00:00";
        Db.AddCall(conversationTitle, isVideoCall, isIncoming: false, isMissed: callSeconds == 0, duration: dur);
        StateHasChanged();
    }

    private void ToggleFlipCamera()
    {
        isFrontCamera = !isFrontCamera;
    }

    public async ValueTask DisposeAsync()
    {
        callDurationTimer?.Dispose();
        ChatClient.OnMessageReceived -= OnSignalRMessageReceived;
        ChatClient.OnUserTyping -= OnSignalRTyping;
        ChatClient.OnUserStoppedTyping -= OnSignalRStoppedTyping;
        await ChatClient.LeaveConversationAsync(ConversationId);
    }
}
