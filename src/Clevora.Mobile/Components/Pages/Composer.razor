@page "/composer"
@page "/composer/{TemplateId:int}"
@using Clevora.Domain.Services
@using Clevora.Mobile.Services
@inject LocalDatabaseService LocalDb

<div class="mobile-composer p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="m-0 fw-bold">✏️ WA Composer</h4>
        <span class="badge bg-success-subtle text-success border border-success-subtle">Offline Ready</span>
    </div>

    <!-- Template selector -->
    <div class="mb-3">
        <label class="form-label small fw-semibold">Pilih Template:</label>
        <select class="form-select form-select-sm" @onchange="OnTemplateSelected">
            <option value="0">— Pesan Baru —</option>
            @foreach (var t in templates)
            {
                <option value="@t.Id" selected="@(t.Id == selectedTemplateId)">
                    @(t.IsFavorite ? "⭐ " : "")@t.Title
                </option>
            }
        </select>
    </div>

    <!-- Nomor HP -->
    <div class="mb-3">
        <label class="form-label small fw-semibold">Nomor WhatsApp Tujuan:</label>
        <input class="form-control form-control-sm"
               value="@recipientPhone"
               @oninput="OnPhoneInput"
               placeholder="08123456789" type="tel" />
    </div>

    <!-- Formatting toolbar + textarea -->
    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label small fw-semibold m-0">Teks Pesan:</label>
            <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-secondary py-0 px-2" @onclick='() => AddFormat("*")'><b>B</b></button>
                <button class="btn btn-outline-secondary py-0 px-2" @onclick='() => AddFormat("_")'><i>I</i></button>
                <button class="btn btn-outline-secondary py-0 px-2" @onclick='() => AddFormat("~")'><s>S</s></button>
                <button class="btn btn-outline-secondary py-0 px-2 font-monospace" @onclick='() => AddFormat("```")'>&lt;&gt;</button>
            </div>
        </div>
        <textarea class="form-control" rows="6" @bind="messageBody" @oninput="OnBodyInput"
                  placeholder="Ketik pesan dengan {{variabel}}..."></textarea>
        <div class="d-flex justify-content-end text-muted" style="font-size:0.75rem; margin-top:4px;">
            @charCount karakter · @wordCount kata
        </div>
    </div>

    <!-- Placeholder inputs -->
    @if (placeholders.Any())
    {
        <div class="card mb-3 bg-light border-0">
            <div class="card-body p-2">
                <small class="fw-bold text-success d-block mb-2">🪄 Isi Variabel:</small>
                @foreach (var p in placeholders)
                {
                    <div class="input-group input-group-sm mb-1">
                        <span class="input-group-text font-monospace small" style="min-width:90px;">
                            &#123;&#123;@p&#125;&#125;
                        </span>
                        <input class="form-control" value="@placeholderValues[p]"
                               @oninput="e => OnPlaceholderInput(p, e)" />
                    </div>
                }
            </div>
        </div>
    }

    <!-- Missing placeholder warning -->
    @if (missingPlaceholders.Any())
    {
        <div class="alert alert-warning py-2 small mb-3">
            ⚠️ Belum diisi: @string.Join(", ", missingPlaceholders.Select(p => $"{{{{{p}}}}}"))
        </div>
    }

    <!-- Live Preview -->
    <div class="card shadow-sm border-0 mb-3" style="background:#efeae2; border-radius:12px;">
        <div class="card-header py-1 px-3 text-white small fw-bold"
             style="background:#075E54; border-radius:12px 12px 0 0;">
            📱 Pratinjau Pesan
        </div>
        <div class="card-body p-3">
            <div class="p-2 rounded bg-white shadow-sm"
                 style="border-radius:8px; font-size:0.9rem; white-space:pre-wrap; min-height:60px;">
                @if (!string.IsNullOrWhiteSpace(htmlPreview))
                {
                    @((MarkupString)htmlPreview)
                }
                else
                {
                    <span class="text-muted fst-italic">Pesan akan tampil di sini...</span>
                }
            </div>
        </div>
    </div>

    <!-- Action buttons -->
    <div class="d-flex flex-column gap-2">
        @if (!string.IsNullOrEmpty(clickToChatUrl))
        {
            <a href="@clickToChatUrl" class="btn btn-success w-100 fw-bold py-2 shadow-sm" target="_blank">
                🚀 Buka di WhatsApp
            </a>
        }
        <button class="btn btn-outline-secondary w-100 py-2" @onclick="ClearAll">🗑️ Bersihkan</button>
    </div>
</div>

@code {
    [Parameter] public int TemplateId { get; set; }

    private List<LocalTemplate> templates = [];
    private int selectedTemplateId;
    private string messageBody = string.Empty;
    private string recipientPhone = string.Empty;
    private List<string> placeholders = [];
    private Dictionary<string, string> placeholderValues = new();
    private List<string> missingPlaceholders = [];
    private string htmlPreview = string.Empty;
    private string clickToChatUrl = string.Empty;
    private int charCount;
    private int wordCount;

    protected override void OnInitialized()
    {
        templates = LocalDb.GetTemplates().ToList();

        if (TemplateId > 0)
        {
            var t = LocalDb.GetTemplate(TemplateId);
            if (t is not null) LoadTemplate(t);
        }
    }

    private void LoadTemplate(LocalTemplate t)
    {
        selectedTemplateId = t.Id;
        messageBody = t.Body;
        RefreshPlaceholders();
        UpdatePreview();
    }

    private void OnTemplateSelected(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var id) || id == 0) return;
        var t = LocalDb.GetTemplate(id);
        if (t is not null) LoadTemplate(t);
    }

    private void OnPhoneInput(ChangeEventArgs e)
    {
        recipientPhone = e.Value?.ToString() ?? string.Empty;
        UpdatePreview();
    }

    private void OnPlaceholderInput(string key, ChangeEventArgs e)
    {
        placeholderValues[key] = e.Value?.ToString() ?? string.Empty;
        UpdatePreview();
    }

    private void OnBodyInput(ChangeEventArgs e)
    {
        messageBody = e.Value?.ToString() ?? string.Empty;
        RefreshPlaceholders();
        UpdatePreview();
    }

    private void AddFormat(string marker)
    {
        messageBody = $"{messageBody}{marker}teks{marker}";
        RefreshPlaceholders();
        UpdatePreview();
    }

    private void RefreshPlaceholders()
    {
        placeholders = PlaceholderParser.ExtractNames(messageBody).ToList();
        foreach (var p in placeholders)
            placeholderValues.TryAdd(p, string.Empty);
        // Remove keys no longer in template
        var toRemove = placeholderValues.Keys.Except(placeholders).ToList();
        foreach (var k in toRemove) placeholderValues.Remove(k);
    }

    private void UpdatePreview()
    {
        missingPlaceholders = PlaceholderParser.FindMissing(messageBody, placeholderValues).ToList();
        var rendered = PlaceholderParser.Render(messageBody, placeholderValues);
        htmlPreview = WhatsAppFormatter.ToHtml(rendered);
        charCount = TextMetricsCalculator.CharacterCount(rendered);
        wordCount = TextMetricsCalculator.WordCount(rendered);

        clickToChatUrl = !string.IsNullOrWhiteSpace(recipientPhone) && ClickToChatUrlBuilder.IsValid(recipientPhone)
            ? ClickToChatUrlBuilder.Build(recipientPhone, rendered)
            : string.Empty;
    }

    private void ClearAll()
    {
        messageBody = string.Empty;
        recipientPhone = string.Empty;
        placeholders.Clear();
        placeholderValues.Clear();
        missingPlaceholders.Clear();
        htmlPreview = string.Empty;
        clickToChatUrl = string.Empty;
        charCount = 0;
        wordCount = 0;
        selectedTemplateId = 0;
    }
}
