@page "/composer"
@using Clevora.Domain.Services
@using Clevora.Mobile.Services
@inject LocalDatabaseService LocalDb

<div class="mobile-composer p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="m-0 fw-bold">📱 WA Composer</h4>
        <span class="badge bg-success-subtle text-success">Offline Ready</span>
    </div>

    <!-- Template selector -->
    <div class="mb-3">
        <label class="form-label small fw-semibold">Pilih Template:</label>
        <select class="form-select form-select-sm" @onchange="OnTemplateSelected">
            <option value="0">— Pesan Baru —</option>
            @foreach (var t in templates)
            {
                <option value="@t.Id">@(t.IsFavorite ? "⭐ " : "")@t.Title</option>
            }
        </select>
    </div>

    <!-- Nomor HP -->
    <div class="mb-3">
        <label class="form-label small fw-semibold">Nomor WhatsApp Tujuan:</label>
        <input class="form-control form-control-sm" @bind="recipientPhone" @bind:event="oninput" @onkeyup="UpdatePreview"
               placeholder="08123456789" type="tel" />
    </div>

    <!-- Body text -->
    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label small fw-semibold m-0">Teks Pesan:</label>
            <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-secondary py-0 px-2" @onclick='() => AddFormat("*")'><b>B</b></button>
                <button class="btn btn-outline-secondary py-0 px-2" @onclick='() => AddFormat("_")'><i>I</i></button>
                <button class="btn btn-outline-secondary py-0 px-2" @onclick='() => AddFormat("~")'><s>S</s></button>
                <button class="btn btn-outline-secondary py-0 px-2 font-monospace" @onclick='() => AddFormat("```")'>&lt;&gt;</button>
            </div>
        </div>
        <textarea class="form-control" rows="5" @bind="messageBody" @oninput="OnBodyInput"
                  placeholder="Ketik pesan dengan {{variabel}}..."></textarea>
    </div>

    <!-- Placeholders input -->
    @if (placeholders.Any())
    {
        <div class="card mb-3 bg-light border-0">
            <div class="card-body p-2">
                <small class="fw-bold text-success d-block mb-2">🪄 Isi Variabel:</small>
                @foreach (var p in placeholders)
                {
                    <div class="input-group input-group-sm mb-1">
                        <span class="input-group-text font-monospace small" style="min-width: 90px;">{{@p}}</span>
                        <input class="form-control" @bind="placeholderValues[p]" @bind:event="oninput" @onkeyup="UpdatePreview" />
                    </div>
                }
            </div>
        </div>
    }

    <!-- Live Preview Card -->
    <div class="card shadow-sm border-0 mb-3" style="background: #efeae2; border-radius: 12px;">
        <div class="card-header py-1 px-3 text-white small" style="background: #075E54; border-radius: 12px 12px 0 0;">
            Pratinjau Pesan
        </div>
        <div class="card-body p-3">
            <div class="p-2 rounded bg-white shadow-sm" style="border-radius: 8px; font-size: 0.9rem; white-space: pre-wrap;">
                @if (!string.IsNullOrWhiteSpace(htmlPreview))
                {
                    @((MarkupString)htmlPreview)
                }
                else
                {
                    <span class="text-muted fst-italic">Pesan akan tampil di sini...</span>
                }
            </div>
        </div>
    </div>

    <!-- Action Button -->
    @if (!string.IsNullOrEmpty(clickToChatUrl))
    {
        <a href="@clickToChatUrl" class="btn btn-success w-100 fw-bold py-2 shadow-sm" target="_blank">
            🚀 Buka di WhatsApp
        </a>
    }
</div>

@code {
    private List<Clevora.Domain.Entities.MessageTemplate> templates = [];
    private string messageBody = string.Empty;
    private string recipientPhone = string.Empty;
    private List<string> placeholders = [];
    private Dictionary<string, string> placeholderValues = new();
    private string htmlPreview = string.Empty;
    private string clickToChatUrl = string.Empty;

    protected override void OnInitialized()
    {
        templates = LocalDb.GetTemplates().ToList();
    }

    private void OnTemplateSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id) && id > 0)
        {
            var t = LocalDb.GetTemplate(id);
            if (t is not null)
            {
                messageBody = t.Body;
                RefreshPlaceholders();
                UpdatePreview();
            }
        }
    }

    private void OnBodyInput(ChangeEventArgs e)
    {
        messageBody = e.Value?.ToString() ?? string.Empty;
        RefreshPlaceholders();
        UpdatePreview();
    }

    private void AddFormat(string marker)
    {
        messageBody = $"{messageBody} {marker}teks{marker} ";
        RefreshPlaceholders();
        UpdatePreview();
    }

    private void RefreshPlaceholders()
    {
        placeholders = PlaceholderParser.ExtractNames(messageBody).ToList();
        foreach (var p in placeholders)
        {
            if (!placeholderValues.ContainsKey(p))
                placeholderValues[p] = string.Empty;
        }
    }

    private void UpdatePreview()
    {
        var rendered = PlaceholderParser.Render(messageBody, placeholderValues);
        htmlPreview = WhatsAppFormatter.ToHtml(rendered);

        if (!string.IsNullOrWhiteSpace(recipientPhone) && ClickToChatUrlBuilder.IsValid(recipientPhone))
        {
            clickToChatUrl = ClickToChatUrlBuilder.Build(recipientPhone, rendered);
        }
        else
        {
            clickToChatUrl = string.Empty;
        }
    }
}
