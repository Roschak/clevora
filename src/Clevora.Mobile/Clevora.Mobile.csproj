<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Target Android only for now; iOS/Mac require a Mac build agent -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Clevora.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <!-- ── App Identity (Play Store) ─────────────────────────────────────── -->
    <ApplicationTitle>Clevora</ApplicationTitle>
    <ApplicationId>com.gravicode.clevora</ApplicationId>
    <!-- Increment ApplicationVersion by 1 for each Play Store upload -->
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- ── Android ───────────────────────────────────────────────────────── -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <!-- Android 7.0+ covers >99% of active devices -->

    <!-- ── Windows ───────────────────────────────────────────────────────── -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <WindowsPackageType>None</WindowsPackageType>

    <!-- ── Release / Play Store AAB ──────────────────────────────────────── -->
    <!-- Sign with keystore: set via CI env vars or Directory.Build.props     -->
    <AndroidKeyStore Condition="'$(Configuration)' == 'Release'">$(AndroidKeyStore)</AndroidKeyStore>
    <AndroidSigningKeyStore Condition="'$(Configuration)' == 'Release'">$(AndroidSigningKeyStore)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias Condition="'$(Configuration)' == 'Release'">$(AndroidSigningKeyAlias)</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass Condition="'$(Configuration)' == 'Release'">$(AndroidSigningKeyPass)</AndroidSigningKeyPass>
    <AndroidSigningStorePass Condition="'$(Configuration)' == 'Release'">$(AndroidSigningStorePass)</AndroidSigningStorePass>
    <!-- Publish as AAB (Android App Bundle) for Play Store -->
    <AndroidPackageFormat Condition="'$(Configuration)' == 'Release'">aab</AndroidPackageFormat>
    <!-- Enable linker and AOT for smaller, faster release builds -->
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">false</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#25D366" />
    <!-- Splash Screen with Clevora brand colour -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#25D366" BaseSize="128,128" />
    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />
    <!-- Raw Assets -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <!-- SQLite persistent local database -->
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.provider.dynamic_cdecl" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clevora.Application\Clevora.Application.csproj" />
    <ProjectReference Include="..\Clevora.Shared\Clevora.Shared.csproj" />
    <ProjectReference Include="..\Clevora.Domain\Clevora.Domain.csproj" />
  </ItemGroup>

</Project>
