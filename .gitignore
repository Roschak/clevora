bin/
obj/
out/
publish/

# NuGet packages
*.nupkg
*.snupkg
*.nuspec
packages/
.nuget/
nuget.config

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/

# Visual Studio / Rider
.idea/
*.DotSettings.user
*.rsuser

# MSBuild crash logs
MSBuild_*.failure.log

